---
import type { Lang } from "../i18n/utils";
import { SKUS } from "../data/skus.js";
import { FINGERPRINT_FIELDS } from "../data/facts.js";
// Font tự host (VEIL-1038): src/styles/fonts.css do scripts/fetch-fonts.mjs sinh. ?url cho tên file đã băm,
// cùng file mà fonts.css trỏ tới — preload và @font-face dùng chung một lần tải.
import plexSansLatin from "../assets/fonts/ibm-plex-sans-latin.woff2?url";
import { currencyForLang, listed } from "../scripts/purchase-core.js";
import {
  t,
  languages,
  supportedLangs,
  defaultLang,
  getLocalizedPath,
  getHreflangs,
} from "../i18n/utils";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Trang mang key license trên URL (/mua): không GA, không analytics.js, không Referer, không index. */
  noTracking?: boolean;
  /** Trang 404: không có URL riêng nên không canonical, không og:url, không hreflang; không index. */
  notFound?: boolean;
}

const lang = Astro.props.lang || defaultLang;
const i = t(lang);
const {
  title = i.meta.title,
  description = i.meta.description,
  noTracking = false,
  notFound = false,
} = Astro.props;

const siteUrl = "https://veilus.io";
const hreflangs = getHreflangs(Astro.url.pathname, siteUrl);
// Canonical là chính trang. Lúc build (format 'directory') pathname luôn có / cuối, cùng dạng với sitemap.
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
// x-default là bản en của CHÍNH trang này, không phải trang chủ.
const xDefault = hreflangs.find((h) => h.lang === defaultLang)!.href;

// Google Analytics 4
const GA_ID = "G-CZ9G6B0L4M";

// Ảnh chia sẻ: tên file mang tháng làm ra nó. Thay ảnh thì đổi tên, mạng xã hội cache theo URL nên mới lấy ảnh mới.
const ogImage = `${siteUrl}/og-image-2026-09.png`;

// JSON-LD Structured Data. Giá theo loại tiền trang đang hiện: bảng giá (Pricing.astro) dùng cùng currencyForLang.
const currency = currencyForLang(lang);
// Mục featureList lấy từ pricing.paidFeatures theo chỉ số có tên, không theo một khoảng: mảng này Pricing.astro hiện
// nguyên thứ tự, cùng thứ tự ở 8 file ngôn ngữ; thêm hay đổi thứ tự mảng thì sửa PAID theo. Không lấy "Veilus Sync"
// (chỉ số 4): trùng ý với home.fig5.syncTitle, câu cụ thể hơn (Git · Google Drive), nên đồng bộ chỉ còn một mục.
const PAID = { flow: 1, scheduling: 2, localApi: 3 };
// Gói đang ẩn (listed) không rao trong JSON-LD — cùng tập gói với bảng giá.
const soldPrices = Object.entries(SKUS)
  .filter(([id, s]) => s.kind !== "addon" && listed(id))
  .map(([, s]) => (currency === "VND" ? s.vnd : s.usd));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Veilus",
  // Tên người dùng gõ khi tìm ("veilus browser"): gắn truy vấn thương hiệu về đúng thực thể.
  alternateName: "Veilus Browser",
  applicationCategory: "BrowserApplication",
  operatingSystem: "Windows, macOS",
  description: i.meta.description,
  url: siteUrl,
  // Free (0) + các gói bán trực tiếp (thuê tháng, trọn đời); gói thêm máy không tính.
  offers: {
    "@type": "AggregateOffer",
    lowPrice: "0",
    highPrice: String(Math.max(...soldPrices)),
    priceCurrency: currency,
    offerCount: String(soldPrices.length + 1),
  },
  // Chuỗi đã dịch mà trang chủ đang hiện: ô fingerprint và ô proxy của FeatureBento, tính năng gói trả phí của
  // Pricing, tiêu đề đồng bộ của Fig5Backup. jsonld.chromiumEngine không hiện ở đâu khác trên trang — không có
  // chuỗi hiện sẵn nào đứng một mình được như một mục tính năng, nên thêm khoá riêng, bám nghĩa faq.items[0].a
  // ("Veilus's own patched Chromium build"), không viết "in-house" hay khẳng định gì mới.
  featureList: [
    i.home.bento.fields.replace("{n}", String(FINGERPRINT_FIELDS)),
    i.home.bento.proxy,
    i.pricing.paidFeatures[PAID.flow],
    i.pricing.paidFeatures[PAID.scheduling],
    i.pricing.paidFeatures[PAID.localApi],
    i.home.fig5.syncTitle,
    i.jsonld.chromiumEngine,
  ],
};

// Organization JSON-LD
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Veilus",
  alternateName: "Veilus Browser",
  url: siteUrl,
  logo: `${siteUrl}/logo-512.png`,
  // Câu giới thiệu ở chân trang, đã dịch 8 ngôn ngữ
  description: i.footer.tagline,
  sameAs: [
    "https://t.me/veilusbrowser",
    "https://x.com/veilusbrowser",
    "https://github.com/veilus",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    url: "https://t.me/veilusbrowser",
  },
};

// WebSite JSON-LD (sitelinks search box)
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Veilus",
  alternateName: "Veilus Browser",
  url: siteUrl,
  description: i.meta.description,
};
// JSON-LD FAQPage không ở đây mà ở FAQ.astro: chỉ trang có hiện FAQ mới được khai nó.
---

<!DOCTYPE html>
<html lang={languages[lang].hreflang} dir={languages[lang].dir}>
  <head>
    <meta charset="UTF-8" />
    {noTracking && <meta name="referrer" content="no-referrer" />}
    {/* noindex bằng meta, không bằng robots.txt: chặn crawl thì Google không đọc được noindex */}
    {(noTracking || notFound) && <meta name="robots" content="noindex" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Hiệu ứng khi cuộn chỉ bật khi có IntersectionObserver; không có thì trang đứng ở trạng thái cuối.
      if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F2EFE7" />
    <meta name="generator" content={Astro.generator} />

    {/* Script trang cần chạy trước GA: trang chủ en đặt script tự chuyển ngôn ngữ vào đây (src/pages/index.astro). */}
    <slot name="head" />

    {/* Google Analytics chỉ đo production (veilus.io): bản preview trên pages.dev, localhost và wrangler không gửi
        page_view. Tắt hẳn trên trang noTracking: page_view gửi cả URL, kể cả ?renew=<key>. gtag.js nạp bằng script
        vì thẻ <script src> tĩnh không có điều kiện; public/analytics.js không làm gì khi không có window.gtag.
        window.veilusLangTo: trang đang tự chuyển ngôn ngữ — page_view để trang đích gửi. */}
    {
      !noTracking && (
        <script
          set:html={`if(location.hostname==='veilus.io'&&!window.veilusLangTo){window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','${GA_ID}');const s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=${GA_ID}';document.head.append(s)}`}
        />
      )
    }

    <!-- Canonical URL -->
    {!notFound && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!notFound && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* Ảnh là màn đầu trang chủ; dòng chữ nhỏ trên tiêu đề của nó là home.fig1.fig */}
    <meta property="og:image:alt" content={`Veilus — ${i.home.fig1.fig}`} />
    <meta property="og:site_name" content="Veilus" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {
      !notFound && supportedLangs.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={languages[l].ogLocale} />
      ))
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    {/* Tài khoản X chính thức: link Twitter/X ở Footer và sameAs của Organization */}
    <meta name="twitter:site" content="@veilusbrowser" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Hreflang for SEO -->
    {
      !notFound && hreflangs.map(({ code, href }) => (
        <link rel="alternate" hreflang={code} href={href} />
      ))
    }
    {!notFound && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}
    ></script>
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)}
    ></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)}
    ></script>

    {/* Chỉ preload chữ Latin của IBM Plex Sans: bốn weight 400–700 dùng chung file này (font biến thiên), mọi
        ngôn ngữ đều có chữ Latin. Subset khác tải theo unicode-range; font icon không preload. */}
    <link rel="preload" href={plexSansLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script is:inline>
      // Gắn .is-in (một lần) và .is-live (khi đang trên màn hình) cho [data-reveal];
      // đếm [data-count-to] từ 0 lên khi phần chứa nó hiện. Giảm chuyển động: không đếm, số đứng yên.
      (() => {
        if (!('IntersectionObserver' in window)) return;
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const countUp = (el) => {
          const to = Number(el.dataset.countTo);
          if (still || !to) return;
          const start = performance.now();
          const frame = (now) => {
            const p = Math.min(1, (now - start) / 1200);
            el.textContent = String(Math.round(to * (1 - (1 - p) ** 3)));
            if (p < 1) requestAnimationFrame(frame);
          };
          requestAnimationFrame(frame);
        };
        const reveal = (el) => {
          if (el.classList.contains('is-in')) return;
          el.classList.add('is-in');
          el.querySelectorAll('[data-count-to]').forEach(countUp);
        };
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              e.target.classList.toggle('is-live', e.isIntersecting);
              if (e.isIntersecting) reveal(e.target);
            }
          },
          { rootMargin: '0px 0px -15% 0px' },
        );
        // io chỉ báo khi phần tử lên khỏi dải 15% đáy màn hình. Phần tử đã trong màn hình lúc tải trang, hoặc nằm
        // trong dải đó khi trang hết chỗ cuộn (viewport cao bằng cả trang như lượt render của Google, hay cuối
        // trang), không bao giờ lên khỏi dải: edge nhìn cả màn hình và hiện chúng ngay (VEIL-1031).
        let atLoad = true;
        const edge = new IntersectionObserver((entries) => {
          const atEnd = scrollY + innerHeight >= document.documentElement.scrollHeight - 1;
          for (const e of entries) if (e.isIntersecting && (atLoad || atEnd)) reveal(e.target);
          atLoad = false;
        });
        document.querySelectorAll('[data-reveal]').forEach((el) => {
          io.observe(el);
          edge.observe(el);
        });
      })();
    </script>

    <!-- GA4 Custom Events -->
    {!noTracking && <script src="/analytics.js" defer />}
  </body>
</html>

<style is:global>
  @import "../styles/fonts.css";
  @import "../styles/global.css";
  @import "../styles/blueprint.css";
</style>
