---
import type { Lang } from "../i18n/utils";
import { SKUS } from "../data/skus.js";
import { iconFontHref } from "../data/icons.js";
import {
  t,
  languages,
  supportedLangs,
  defaultLang,
  getLocalizedPath,
  getHreflangs,
} from "../i18n/utils";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Trang mang key license trên URL (/mua): không GA, không analytics.js, không Referer. */
  noTracking?: boolean;
}

const lang = Astro.props.lang || defaultLang;
const i = t(lang);
const {
  title = i.meta.title,
  description = i.meta.description,
  noTracking = false,
} = Astro.props;

const siteUrl = "https://veilus.io";
const hreflangs = getHreflangs(Astro.url.pathname, siteUrl);
const canonicalUrl =
  lang === defaultLang ? `${siteUrl}/` : `${siteUrl}/${lang}/`;

// Google Analytics 4 — Replace G-XXXXXXXXXX with your Measurement ID
const GA_ID = "G-CZ9G6B0L4M";

// JSON-LD Structured Data
const soldUsd = Object.values(SKUS)
  .filter((s) => s.kind !== "addon")
  .map((s) => s.usd);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Veilus",
  applicationCategory: "BrowserApplication",
  operatingSystem: "Windows, macOS",
  description: i.meta.description,
  url: siteUrl,
  // Free (0) + các gói bán trực tiếp (thuê tháng, trọn đời); gói thêm máy không tính.
  offers: {
    "@type": "AggregateOffer",
    lowPrice: "0",
    highPrice: String(Math.max(...soldUsd)),
    priceCurrency: "USD",
    offerCount: String(soldUsd.length + 1),
  },
  featureList: [
    "Separate fingerprint and proxy per profile",
    "Script automation written by your AI assistant over MCP, or by you (Veilus Flow)",
    "Schedules and batch runs",
    "Local REST API and MCP",
    "Profile sync via Git or Google Drive (Veilus Sync)",
  ],
};

// Organization JSON-LD
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Veilus",
  url: siteUrl,
  logo: `${siteUrl}/logo-512.png`,
  description:
    "Anti-detect browser with built-in automation. Each profile gets its own fingerprint and proxy on an in-house Chromium engine.",
  sameAs: [
    "https://t.me/veilusbrowser",
    "https://x.com/veilusbrowser",
    "https://github.com/veilus",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    url: "https://t.me/veilusbrowser",
  },
};

// WebSite JSON-LD (sitelinks search box)
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Veilus",
  url: siteUrl,
  description: i.meta.description,
};

// FAQ JSON-LD (for rich snippets)
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: i.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<!DOCTYPE html>
<html lang={lang} dir={languages[lang].dir}>
  <head>
    <meta charset="UTF-8" />
    {noTracking && <meta name="referrer" content="no-referrer" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F2EFE7" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Analytics — tắt trên trang noTracking: page_view gửi cả URL, kể cả ?renew=<key> -->
    {
      !noTracking && (
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
        />
      )
    }
    {
      !noTracking && (
        <script
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${GA_ID}');`}
        />
      )
    }

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Veilus — Anti-detect browser" />
    <meta property="og:site_name" content="Veilus" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : lang} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <!-- Hreflang for SEO -->
    {
      hreflangs.map(({ lang: l, href }) => (
        <link rel="alternate" hreflang={l} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}
    ></script>
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)}
    ></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)}
    ></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}
    ></script>

    <!-- Fonts (preconnect for performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link href={iconFontHref()} rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <!-- GA4 Custom Events -->
    {!noTracking && <script src="/analytics.js" defer />}
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
  @import "../styles/blueprint.css";
</style>
