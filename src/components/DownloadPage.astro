---
/**
 * Trang tải về, dùng chung cho /download (en) và /[lang]/download.
 */
import type { Lang } from '../i18n/utils';
import { t } from '../i18n/utils';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import {
  OS_SUPPORT,
  INSTALLER_SIZE,
  ENGINE_SIZE,
  APP_VERSION,
  DOWNLOAD_URL,
  RELEASES_URL,
  RELEASE_AT,
  DOWNLOADS_OPEN,
} from '../data/facts.js';

const MAC_QUARANTINE_CMD = "xattr -dr com.apple.quarantine /Applications/Veilus.app";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const i = t(lang);
// Link tải luôn có trong HTML; trước RELEASE_AT nó ẩn và thẻ hiện ngày ra mắt. DOWNLOADS_OPEN (lúc build) chỉ là
// trạng thái ban đầu — script cuối trang so giờ của người xem với RELEASE_AT, nên tới giờ là hiện, không cần build lại.
const availableOn = i.download.availableOn.replace(
  "{date}",
  new Intl.DateTimeFormat(lang, { day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Ho_Chi_Minh" }).format(
    new Date(RELEASE_AT),
  ),
);
---

<Navbar lang={lang} />
<main class="download-page" data-release-at={RELEASE_AT}>
  <section class="download-hero">
    <div class="container">
      <h1>
        {i.download.title}
        <span class="text-gradient">{i.download.titleHighlight}</span>
      </h1>
      <p class="download-subtitle">{i.download.subtitle}</p>

      <!-- Platform Cards -->
      <div class="platform-cards">
        <div class="platform-card">
          <div class="platform-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M3 12V6.75l8-1.25V12H3zm0 .5h8v6.5L3 17.75V12.5zm9 0h9V3.5l-9 1.25V12.5zm0 .5v6.25L21 20.5V13H12z"
              ></path></svg
            >
          </div>
          <h2 class="platform-name">Windows</h2>
          <p class="platform-version">{OS_SUPPORT.windows}</p>
          <a class="btn btn-primary platform-download" data-release="open" data-download="windows" hidden={!DOWNLOADS_OPEN} href={DOWNLOAD_URL.windows}>{i.download.cta.replace("{os}", "Windows")}</a>
          <span class="release-badge" data-release="soon" hidden={DOWNLOADS_OPEN}>{availableOn}</span>
          <span class="platform-size">{INSTALLER_SIZE.windows}</span>
        </div>

        <div class="platform-card">
          <div class="platform-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
              ></path></svg
            >
          </div>
          <h2 class="platform-name">macOS</h2>
          <p class="platform-version">{OS_SUPPORT.macos}</p>
          <a class="btn btn-primary platform-download" data-release="open" data-download="macos" hidden={!DOWNLOADS_OPEN} href={DOWNLOAD_URL.macos}>{i.download.cta.replace("{os}", "macOS")}</a>
          <span class="release-badge" data-release="soon" hidden={DOWNLOADS_OPEN}>{availableOn}</span>
          <span class="platform-size">{INSTALLER_SIZE.macos}</span>
        </div>
      </div>

      <p class="release-links" data-release="open" hidden={!DOWNLOADS_OPEN}>{i.download.version.replace("{version}", APP_VERSION)} · <a href={RELEASES_URL}>{i.download.allVersions}</a></p>

      <!-- Cài lần đầu trên macOS: bản ký ad-hoc, không công chứng (VEIL-558 đã huỷ) nên dmg tải bằng trình duyệt bị gắn quarantine. -->
      <div class="mac-note">
        <h2>{i.download.macTitle}</h2>
        <p>{i.download.macStep}</p>
        <div class="mac-cmd">
          <pre><code id="mac-cmd">{MAC_QUARANTINE_CMD}</code></pre>
          <button type="button" class="btn btn-secondary" id="mac-cmd-copy" data-copy={i.buy.copy} data-copied={i.buy.copied}>{i.buy.copy}</button>
        </div>
        <p>{i.download.macOnce}</p>
      </div>

      <!-- Trust Badges -->
      <div class="trust-badges">
        <div class="trust-badge">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect x="1" y="4" width="22" height="16" rx="2" ry="2"
            ></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg
          >
          <span>{i.download.noCard}</span>
        </div>
        <div class="trust-badge">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
            ></path><circle cx="12" cy="7" r="4"></circle></svg
          >
          <span>{i.download.freeProfiles}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="system-req">
    <div class="container">
      <h2>{i.download.reqTitle}</h2>
      <div class="req-grid">
        <div class="req-card">
          <h3 class="req-name">Windows</h3>
          <ul>
            <li>{OS_SUPPORT.windows}</li>
            <li>{i.download.engine} <span class="req-size">({ENGINE_SIZE.windows})</span></li>
          </ul>
        </div>
        <div class="req-card">
          <h3 class="req-name">macOS</h3>
          <ul>
            <li>{OS_SUPPORT.macos}</li>
            <li>{i.download.engine} <span class="req-size">({ENGINE_SIZE.macos})</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</main>
<script is:inline>
  (() => {
    const main = document.querySelector("main[data-release-at]");
    const at = Date.parse(main?.dataset.releaseAt ?? "");
    if (!Number.isFinite(at)) return;
    const apply = () => {
      const open = Date.now() >= at;
      for (const el of document.querySelectorAll("[data-release]")) el.hidden = (el.dataset.release === "open") !== open;
      return open;
    };
    if (!apply()) setTimeout(apply, Math.min(at - Date.now() + 1000, 2 ** 31 - 1));
  })();
</script>
<script is:inline>
  document.getElementById("mac-cmd-copy")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    try {
      await navigator.clipboard.writeText(document.getElementById("mac-cmd").textContent);
      btn.textContent = btn.dataset.copied;
    } catch {
      /* trình duyệt chặn clipboard: người dùng vẫn chép tay được */
    }
  });
</script>
<Footer lang={lang} />

<style>
  .download-page {
    padding-top: var(--nav-height);
  }
  .download-hero {
    padding: var(--space-3xl) 0;
    text-align: center;
    background: radial-gradient(
      ellipse 80% 50% at 50% -20%,
      rgba(27, 34, 48, 0.04),
      transparent
    );
  }
  .download-hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin-bottom: var(--space-md);
  }
  /* "Veilus" luôn một dòng riêng. Để nó tự xuống dòng thì trên di động nó rớt xuống dòng mới khi IBM Plex
     tải xong và đẩy mọi thứ bên dưới xuống (VEIL-1031 đo ra CLS 0,12–0,15, lúc trang còn form danh sách chờ). */
  .download-hero h1 .text-gradient {
    display: block;
  }
  .download-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 50ch;
    margin: 0 auto var(--space-xl);
  }

  .platform-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    max-width: 640px;
    margin: 0 auto;
  }
  .platform-card {
    position: relative;
    padding: var(--space-xl) var(--space-lg);
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    transition: border-color var(--transition-fast);
  }
  .platform-card:hover {
    border-color: var(--color-border-light);
  }
  .platform-icon {
    width: 48px;
    height: 48px;
    color: var(--color-text);
  }
  .platform-icon svg {
    width: 100%;
    height: 100%;
  }
  .platform-name {
    font-size: 1.25rem;
    margin: 0;
  }
  .platform-version {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .platform-download {
    margin-top: var(--space-xs);
    max-width: 100%;
    justify-content: center;
    text-align: center;
    white-space: normal;
  }
  /* `hidden` của nút tải/ngày ra mắt phải thắng display của .btn và .release-badge. */
  .download-page [hidden] {
    display: none !important;
  }

  .release-badge {
    display: inline-block;
    margin-top: var(--space-xs);
    padding: 6px 16px;
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--acc-soft);
    color: var(--ink);
    border: 1px solid var(--rule);
  }
  .platform-size {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  /* p toàn cục có max-width 60ch: thiếu auto thì hộp dạt trái ở màn rộng. */
  .release-links {
    margin: var(--space-lg) auto 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
  }
  .mac-note {
    max-width: 640px;
    margin: var(--space-xl) auto 0;
    padding: var(--space-lg);
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: left;
  }
  .mac-note h2 {
    font-size: 1rem;
    margin: 0 0 var(--space-sm);
  }
  .mac-note p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-sm);
    max-width: none;
  }
  .mac-cmd {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: flex-start;
    margin-bottom: var(--space-sm);
  }
  .mac-cmd pre {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    background: var(--panel);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .trust-badges {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    flex-wrap: wrap;
  }
  .trust-badge {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 8px 16px;
    border-radius: 99px;
    border: 1px solid var(--color-border);
    background: var(--panel);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }
  .trust-badge svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    stroke: var(--ink);
  }

  .system-req {
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--color-border);
  }
  .system-req h2 {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .req-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    max-width: 640px;
    margin: 0 auto;
  }
  .req-card {
    padding: var(--space-lg);
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .req-name {
    margin: 0 0 var(--space-sm);
    font-size: 1rem;
  }
  .req-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .req-card li {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    padding: 4px 0;
  }
  .req-size {
    white-space: nowrap;
  }
  .req-card li::before {
    content: "→ ";
    color: var(--ink);
  }

  @media (max-width: 768px) {
    .platform-cards,
    .req-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
    }
  }
</style>
