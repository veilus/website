---
import type { Lang } from "../i18n/utils";
import { t, defaultLang, getLocalizedPath } from "../i18n/utils";

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang || defaultLang;
const i = t(lang);
---

<section class="hero" id="hero">
  <div class="hero-bg"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <div class="badge badge-gold animate-fade-in">
        <svg
          class="icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="width:14px;height:14px"
          ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
        >
        {i.hero.badge}
      </div>

      <h1 class="hero-title animate-fade-in animate-delay-1">
        {i.hero.title}
        <span class="text-gradient">{i.hero.titleHighlight}</span>
      </h1>

      <p class="hero-subtitle animate-fade-in animate-delay-2">
        {i.hero.subtitle}
      </p>

      <div class="hero-cta animate-fade-in animate-delay-3">
        <a
          href={getLocalizedPath("/download", lang)}
          class="btn btn-primary btn-large"
        >
          <svg
            class="icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
              points="7 10 12 15 17 10"></polyline><line
              x1="12"
              y1="15"
              x2="12"
              y2="3"></line></svg
          >
          {i.hero.cta}
        </a>
        <p class="hero-micro">{i.hero.micro}</p>
        <p class="hero-platforms">{i.hero.platforms}</p>
      </div>
    </div>

    <div class="hero-visual animate-fade-in animate-delay-2">
      <div class="hero-app-frame">
        <div class="app-titlebar">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
          <span class="app-title">Veilus</span>
        </div>
        <div class="app-content">
          <div class="app-sidebar">
            <div class="sidebar-item active">
              <div
                class="profile-avatar"
                style="background: linear-gradient(135deg, #00D4FF, #6366F1)"
              >
              </div>
              <div class="profile-info">
                <span class="profile-name">Marketing VN</span><span
                  class="profile-badge">#fp-a8k2</span>
              </div>
            </div>
            <div class="sidebar-item">
              <div
                class="profile-avatar"
                style="background: linear-gradient(135deg, #22C55E, #16A34A)"
              >
              </div>
              <div class="profile-info">
                <span class="profile-name">Shop Shopee 01</span><span
                  class="profile-badge">#fp-m3j7</span>
              </div>
            </div>
            <div class="sidebar-item">
              <div
                class="profile-avatar"
                style="background: linear-gradient(135deg, #F59E0B, #D97706)"
              >
              </div>
              <div class="profile-info">
                <span class="profile-name">Ads Manager</span><span
                  class="profile-badge">#fp-x9q1</span>
              </div>
            </div>
          </div>
          <div class="app-main">
            <div class="app-placeholder">
              <div class="placeholder-line w80"></div>
              <div class="placeholder-line w60"></div>
              <div class="placeholder-block"></div>
              <div class="placeholder-line w70"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .hero {
    position: relative;
    min-height: 100vh;
    padding: calc(var(--nav-height) + var(--space-3xl)) 0 var(--space-3xl);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 80% 50% at 50% -20%,
        rgba(0, 212, 255, 0.12),
        transparent
      ),
      radial-gradient(
        ellipse 60% 40% at 80% 60%,
        rgba(99, 102, 241, 0.08),
        transparent
      ),
      var(--bg-primary);
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }
  .hero-inner > * {
    min-width: 0;
  }
  .hero-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.15;
    margin-top: var(--space-lg);
  }
  .hero-subtitle {
    font-size: 1.2rem;
    line-height: 1.7;
    margin-top: var(--space-lg);
    max-width: 48ch;
  }
  .hero-cta {
    margin-top: var(--space-xl);
  }
  .hero-micro {
    margin-top: var(--space-md);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }
  .hero-platforms {
    margin-top: var(--space-xs);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .hero-app-frame {
    width: 100%;
    max-width: 480px;
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    box-shadow: var(--shadow-xl), var(--shadow-glow);
  }
  .app-titlebar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--color-border);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .dot-red {
    background: #ff5f57;
  }
  .dot-yellow {
    background: #febc2e;
  }
  .dot-green {
    background: #28c840;
  }
  .app-title {
    margin-left: 8px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .app-content {
    display: grid;
    grid-template-columns: 180px 1fr;
    min-height: 280px;
  }
  .app-sidebar {
    padding: 12px;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--transition-fast);
  }
  .sidebar-item:hover,
  .sidebar-item.active {
    background: rgba(0, 212, 255, 0.08);
  }
  .sidebar-item.active {
    border: 1px solid rgba(0, 212, 255, 0.15);
  }
  .profile-avatar {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
  }
  .profile-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .profile-badge {
    font-size: 0.625rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
  .app-main {
    padding: 20px;
  }
  .app-placeholder {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .placeholder-line {
    height: 10px;
    border-radius: 4px;
    background: var(--color-border);
  }
  .placeholder-block {
    height: 80px;
    border-radius: 8px;
    background: var(--color-border);
  }
  .w80 {
    width: 80%;
  }
  .w70 {
    width: 70%;
  }
  .w60 {
    width: 60%;
  }
  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-app-frame {
      max-width: 420px;
    }
  }
  @media (max-width: 768px) {
    .hero {
      padding-top: calc(var(--nav-height) + var(--space-xl));
    }
    .app-content {
      grid-template-columns: 1fr;
    }
    .app-sidebar {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      flex-direction: row;
      overflow-x: auto;
    }
    .sidebar-item {
      min-width: 140px;
    }
  }
</style>
