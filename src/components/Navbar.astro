---
/**
 * Thanh điều hướng dùng chung mọi trang (spec trang chủ §2): mark "VEILUS / BẢN VẼ 02", liên kết tới
 * các phần của trang chủ, chọn ngôn ngữ, nút tải về. Dưới 1180px liên kết gập vào nút menu.
 */
import type { Lang } from '../i18n/utils';
import LogoMark from './LogoMark.astro';
import { t, languages, supportedLangs, defaultLang, getLocalizedPath, stripLang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang || defaultLang;
const i = t(lang);
const home = getLocalizedPath('/', lang);

// Đường dẫn bỏ tiền tố ngôn ngữ (vd /vi/cookies/ → /cookies/), để đổi ngôn ngữ mà vẫn ở trang đang xem
const basePath = stripLang(Astro.url.pathname);
// Tên đọc lên của nút ngôn ngữ chứa chữ nhìn thấy trên nút, "EN — Language" (WCAG 2.5.3): người dùng điều khiển
// bằng giọng nói gọi nút bằng đúng chữ họ thấy.
const langLabel = `${lang.toUpperCase()} — ${i.nav.language}`;

// Neo của các phần trang chủ — task 6–13 dựng phần có đúng id này; Giá là trang riêng /pricing/ (VEIL-1304), MCP là /features/mcp/ (VEIL-1314)
const anchor = (id: string) => `${home}#${id}`;
const LINKS = [
  [anchor('anti-detect'), i.nav.antiDetect],
  [anchor('profile'), i.nav.profile],
  [getLocalizedPath('/features/mcp', lang), i.nav.mcp],
  [anchor('backup'), i.nav.backup],
  [anchor('features'), i.nav.features],
  [getLocalizedPath('/pricing', lang), i.nav.pricing],
  [anchor('faq'), i.nav.faq],
];
---

<header class="k-wrap">
  <nav class="k-nav" aria-label="Veilus">
    <a class="k-mark" href={home} aria-label="Veilus"><LogoMark /><span class="k-mark-text">VEILUS</span></a>
    <div class="k-links" id="k-links">
      {LINKS.map(([href, label]) => <a href={href}>{label}</a>)}
    </div>
    <div class="k-act">
      <div class="k-lang">
        <button
          class="k-lang-btn"
          id="k-lang-btn"
          type="button"
          aria-expanded="false"
          aria-controls="k-lang-menu"
          aria-label={langLabel}
        >
          <span class="ms" data-icon="language" aria-hidden="true"></span>{lang.toUpperCase()}<span class="ms" data-icon="expand_more" aria-hidden="true"></span>
        </button>
        <div class="k-lang-menu" id="k-lang-menu">
          {supportedLangs.map((l) => (
            <a href={getLocalizedPath(basePath, l)} lang={languages[l].hreflang} hreflang={languages[l].hreflang} aria-current={l === lang ? 'true' : undefined}>
              {languages[l].label}
            </a>
          ))}
        </div>
      </div>
      <a class="k-btn k-btn-sm" href={getLocalizedPath('/download', lang)} data-cta="navbar_download">{i.nav.download}</a>
      <button class="k-menu-btn" id="k-menu-btn" type="button" aria-controls="k-links" aria-expanded="false" aria-label={i.nav.menu}>
        <span class="ms" data-icon="menu" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>

<script>
  const langBtn = document.getElementById('k-lang-btn');
  const langMenu = document.getElementById('k-lang-menu');
  const menuBtn = document.getElementById('k-menu-btn');
  const links = document.getElementById('k-links');

  const setLang = (open: boolean) => {
    langMenu?.classList.toggle('open', open);
    langBtn?.setAttribute('aria-expanded', String(open));
  };
  const setMenu = (open: boolean) => {
    links?.classList.toggle('open', open);
    menuBtn?.setAttribute('aria-expanded', String(open));
  };

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setLang(!langMenu?.classList.contains('open'));
  });
  document.addEventListener('click', () => setLang(false));
  // Escape đóng menu đang mở và trả focus về nút đã mở nó. Không menu nào mở thì không đụng tới focus.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (langMenu?.classList.contains('open')) {
      setLang(false);
      langBtn?.focus();
    }
    if (links?.classList.contains('open')) {
      setMenu(false);
      menuBtn?.focus();
    }
  });
  menuBtn?.addEventListener('click', () => setMenu(!links?.classList.contains('open')));
  links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
</script>

<style>
  .k-nav { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 18px 0; border-bottom: 1.5px solid var(--ink); }
  .k-links { display: flex; gap: 22px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
  .k-links a { color: var(--ink); white-space: nowrap; }
  .k-links a:hover { color: var(--acc); }
  .k-act { display: flex; align-items: center; gap: 12px; }
  .k-lang { position: relative; }
  .k-lang-btn { display: inline-flex; align-items: center; gap: 4px; padding: 7px 8px; background: transparent; border: 1.5px solid var(--ink); color: var(--ink); font: 600 12px/1 var(--font-mono); letter-spacing: 0.06em; cursor: pointer; }
  .k-lang-btn .ms { font-size: 17px; }
  .k-lang-menu { display: none; position: absolute; right: 0; top: calc(100% + 6px); min-width: 170px; background: var(--paper); border: 1.5px solid var(--ink); box-shadow: 6px 6px 0 var(--grid2); z-index: 20; }
  .k-lang-menu.open { display: block; }
  .k-lang-menu a { display: block; padding: 9px 14px; font-size: 14px; color: var(--ink); }
  .k-lang-menu a + a { border-top: 1px solid var(--rule); }
  .k-lang-menu a:hover,
  .k-lang-menu a[aria-current='true'] { background: var(--ink); color: var(--paper); }
  .k-menu-btn { display: none; padding: 5px; background: transparent; border: 1.5px solid var(--ink); color: var(--ink); cursor: pointer; }

  @media (max-width: 1180px) {
    .k-menu-btn { display: inline-flex; }
    .k-links { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; gap: 0; background: var(--paper); border: 1.5px solid var(--ink); border-top: 0; z-index: 20; }
    .k-links.open { display: flex; }
    .k-links a { padding: 14px 16px; }
    .k-links a + a { border-top: 1px solid var(--rule); }
  }

  @media (max-width: 640px) {
    .k-nav { gap: 12px; }
    .k-act { gap: 8px; }
    /* Ở 320–375px thanh đã hết chỗ từ trước khi có khiên (đo 2026-10-04: khe giữa mark và nhóm nút đúng bằng gap).
       Khiên cạnh chữ làm nút tải về xuống thêm dòng và đẩy nút menu ra ngoài mép ở 320px: chỉ giữ khiên, tên đọc
       lên vẫn là aria-label của liên kết. */
    .k-mark-text { display: none; }
  }

  /* Dưới 360px nút ngôn ngữ, nút tải về và nút menu vượt lề phải tới 7px (ru "Скачать бесплатно"): khít lại. */
  @media (max-width: 359px) {
    .k-nav { gap: 8px; }
    .k-act { gap: 6px; }
    .k-lang-btn { padding: 7px 6px; }
  }
</style>
