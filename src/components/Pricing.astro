---
/**
 * Bảng giá trang chủ. Giá đọc từ `data/skus.js` (bản sao bảng SKU của API);
 * chữ đọc từ i18n. Một loại tiền mỗi ngôn ngữ (vi → VNĐ, còn lại USD). Nút mua dẫn tới /mua?sku=.
 */
import type { Lang } from '../i18n/utils';
import { t, defaultLang, getLocalizedPath } from '../i18n/utils';
import { SKUS } from '../data/skus.js';
import { currencyForLang, formatPrice } from '../scripts/purchase-core.js';
interface Props { lang?: Lang; }
const lang = Astro.props.lang || defaultLang;
const i = t(lang);
const p = i.pricing;
const cur = currencyForLang(lang);
const price = (s: { vnd: number; usd: number }) => formatPrice(cur === 'VND' ? s.vnd : s.usd, cur, lang);
const devices = (n: number) => (n === 1 ? p.device : p.devices.replace('{n}', String(n)));
const buyHref = (sku: string) => getLocalizedPath(`/mua?sku=${sku}`, lang);
const lifetime = Object.entries(SKUS).filter(([, s]) => s.kind === 'lifetime');
const monthly = SKUS.monthly;
const CONTACT_URL = 'https://t.me/veilusbrowser';
---
<section class="section pricing" id="pricing" data-animate>
  <div class="container">
    <div class="section-header">
      <span class="badge badge-gold">{p.badge}</span>
      <h2 class="mt-md">{p.title} <span class="text-gradient">{p.titleHighlight}</span></h2>
      <p>{p.subtitle}</p>
    </div>
    <div class="pricing-grid">
      <div class="pricing-card card">
        <div class="plan-header"><h3 class="plan-name">{p.free.name}</h3><p class="plan-desc">{p.free.desc}</p></div>
        <div class="plan-price">
          <span class="price-value">{formatPrice(0, cur, lang)}</span><span class="price-period">{p.free.period}</span>
        </div>
        <ul class="plan-features">
          {p.free.features.map((f) => <li><span class="check" aria-hidden="true">✓</span>{f}</li>)}
          <li class="excluded"><span class="check" aria-hidden="true">–</span>{p.free.excluded}</li>
        </ul>
        <p class="plan-trial">{p.free.trial}</p>
        <a href={getLocalizedPath('/download', lang)} class="btn btn-secondary plan-cta">{p.free.cta}</a>
      </div>

      <div class="pricing-card card">
        <div class="plan-header"><h3 class="plan-name">{p.monthly.name}</h3><p class="plan-desc">{p.monthly.desc}</p></div>
        <div class="plan-price">
          <span class="price-value">{price(monthly)}</span><span class="price-period">{p.perMonth}</span>
        </div>
        <ul class="plan-features">
          {p.paidFeatures.map((f) => <li><span class="check" aria-hidden="true">✓</span>{f}</li>)}
        </ul>
        <a href={buyHref('monthly')} class="btn btn-secondary plan-cta">{p.monthly.cta}</a>
      </div>

      <div class="pricing-card card popular">
        <div class="plan-header"><h3 class="plan-name">{p.lifetime.name}</h3><p class="plan-desc">{p.lifetime.desc}</p></div>
        <ul class="tiers">
          {lifetime.map(([id, s]) => (
            <li>
              <a class="tier" href={buyHref(id)}>
                <span class="tier-name">{i.buy.sku[id as keyof typeof i.buy.sku]}<small>{devices(s.devices)}</small></span>
                <span class="tier-price">{price(s)}</span>
                <span class="tier-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <ul class="plan-features">
          <li><span class="check" aria-hidden="true">✓</span>{p.lifetime.everything}</li>
          <li><span class="check" aria-hidden="true">✓</span>{p.lifetime.terms}</li>
        </ul>
        <p class="contact">{p.contact} <a href={CONTACT_URL} target="_blank" rel="noopener noreferrer">{p.contactCta}</a></p>
      </div>
    </div>
    <p class="refund-note"><a href={getLocalizedPath('/refund', lang)}>{p.refund}</a></p>
  </div>
</section>
<style>
  .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); align-items: start; }
  .pricing-card { display: flex; flex-direction: column; cursor: default; }
  .pricing-card.popular { border-color: var(--color-cyan); box-shadow: var(--shadow-glow); }
  .plan-header { margin-bottom: var(--space-lg); }
  .plan-name { font-size: 1.25rem; font-weight: 700; }
  .plan-desc { font-size: 0.875rem; margin-top: var(--space-xs); }
  .plan-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px var(--space-xs); margin-bottom: var(--space-lg); padding-bottom: var(--space-lg); border-bottom: 1px solid var(--color-border); }
  .price-value { font-size: 2rem; font-weight: 700; color: var(--color-text); line-height: 1.1; }
  .price-period { font-size: 0.9375rem; color: var(--color-text-muted); }
  .plan-trial { font-size: 0.875rem; color: var(--color-text-secondary); margin-bottom: var(--space-md); }
  .plan-features { list-style: none; display: flex; flex-direction: column; gap: var(--space-sm); margin-bottom: var(--space-xl); flex-grow: 1; }
  .plan-features li { display: flex; align-items: flex-start; gap: var(--space-sm); font-size: 0.9375rem; color: var(--color-text-secondary); }
  .check { width: 18px; flex-shrink: 0; color: var(--color-success); font-weight: 700; }
  .excluded { color: var(--color-text-muted) !important; }
  .excluded .check { color: var(--color-text-muted); }
  .plan-cta { width: 100%; justify-content: center; text-align: center; }
  .tiers { list-style: none; display: flex; flex-direction: column; gap: var(--space-xs); margin-bottom: var(--space-lg); }
  .tier { display: flex; align-items: center; gap: var(--space-sm); padding: 10px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); text-decoration: none; }
  .tier:hover, .tier:focus-visible { border-color: var(--color-cyan); }
  .tier small { display: block; font-size: 0.75rem; font-weight: 400; color: var(--color-text-muted); }
  .tier-name { flex: 1; font-weight: 600; }
  .tier-price { text-align: right; font-weight: 700; white-space: nowrap; }
  .tier-go { color: var(--color-text-muted); }
  .contact { font-size: 0.875rem; color: var(--color-text-muted); }
  .refund-note { margin: var(--space-lg) auto 0; max-width: none; text-align: center; font-size: 0.875rem; color: var(--color-text-muted); }
  .refund-note a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1024px) { .pricing-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; } }
</style>
