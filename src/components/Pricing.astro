---
/**
 * Bảng 2 — giá (spec trang chủ §4 dòng 7): nội dung giữ như website cũ, chỉ đổi giao diện theo bản vẽ.
 * Giá đọc từ data/skus.js (bản sao bảng SKU của API); một loại tiền mỗi ngôn ngữ (vi → VNĐ, còn lại USD).
 * Nút mua đi đường nào do payRoute (scripts/purchase-core.js) quyết: thẻ và VNĐ → /mua?sku=, USDT →
 * /mua?sku=&method=usdt, kênh tắt hoặc gói không có đường nào → Telegram. Trang /mua dùng cùng hàm này.
 * Gói ẩn (listed) không có dòng nào, nên cũng không có link USDT cho chúng.
 */
import type { Lang } from '../i18n/utils';
import { t, defaultLang, getLocalizedPath } from '../i18n/utils';
import { SKUS } from '../data/skus.js';
import { currencyForLang, formatPrice, payRoute, TELEGRAM_URL, listed } from '../scripts/purchase-core.js';

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang || defaultLang;
const i = t(lang);
const p = i.pricing;
const hp = i.home.pricing;
const cur = currencyForLang(lang);
const price = (s: { vnd: number; usd: number }) => formatPrice(cur === 'VND' ? s.vnd : s.usd, cur, lang);
const devices = (n: number) => (n === 1 ? p.device : p.devices.replace('{n}', String(n)));
const buyHref = (sku: string) => getLocalizedPath(`/mua?sku=${sku}`, lang);
// Đích của nút mua một gói theo payRoute; `via` là nhãn nhỏ cạnh số máy khi gói không mua bằng thẻ/VNĐ.
type Buy = { href: string; target?: string; rel?: string; via?: string };
const buy = (sku: string): Buy => {
  const route = payRoute(cur, sku);
  if (route === 'telegram') return { href: TELEGRAM_URL, target: '_blank', rel: 'noopener noreferrer', via: p.viaTelegram };
  if (route === 'usdt') return { href: getLocalizedPath(`/mua?sku=${sku}&method=usdt`, lang), via: p.viaUsdt };
  return { href: buyHref(sku) };
};
const monthlyBuy = buy('monthly');
const lifetime = Object.entries(SKUS).filter(([id, s]) => s.kind === 'lifetime' && listed(id));
---

<section class="k-wrap k-sec" id="pricing" data-reveal>
  <div class="k-fig">{hp.fig}</div>
  <h2 class="k-h2">{p.title} {p.titleHighlight}</h2>
  <p class="k-sub">{p.subtitle}</p>
  <div class="k-price">
    <div class="k-pc k-rise" style="--d:0.1s">
      <div><div class="k-pn">{p.free.name}</div><div class="k-pd">{p.free.desc}</div></div>
      <div class="k-pp"><b>{formatPrice(0, cur, lang)}</b><span>{p.free.period}</span></div>
      <ul class="k-pf">
        {p.free.features.map((x) => <li><span class="ms" data-icon="check" aria-hidden="true"></span><span>{x}</span></li>)}
        <li class="k-px"><span class="ms" data-icon="remove" aria-hidden="true"></span><span>{p.free.excluded}</span></li>
      </ul>
      <div class="k-trial"><span class="ms" data-icon="bolt" aria-hidden="true"></span>{p.free.trial}</div>
      <a class="k-btn k-btn-o" href={getLocalizedPath('/download', lang)} data-cta="pricing_cta" data-plan="free">{p.free.cta}</a>
    </div>

    <div class="k-pc k-rise" style="--d:0.2s">
      <div><div class="k-pn">{p.monthly.name}</div><div class="k-pd">{p.monthly.desc}</div></div>
      <div class="k-pp"><b>{price(SKUS.monthly)}</b><span>{p.perMonth}</span></div>
      <ul class="k-pf">
        {p.paidFeatures.map((x) => <li><span class="ms" data-icon="check" aria-hidden="true"></span><span>{x}</span></li>)}
      </ul>
      <a class="k-btn k-btn-o" href={monthlyBuy.href} target={monthlyBuy.target} rel={monthlyBuy.rel} data-cta="pricing_cta" data-plan="monthly">{p.monthly.cta}{monthlyBuy.via ? ` · ${monthlyBuy.via}` : ''}</a>
    </div>

    <div class="k-pc k-pc-pop k-rise" style="--d:0.3s">
      <span class="k-pc-tag">{hp.once}</span>
      <div><div class="k-pn">{p.lifetime.name}</div><div class="k-pd">{p.lifetime.desc}</div></div>
      <div class="k-tiers">
        {lifetime.map(([id, s]) => {
          const name = i.buy.sku[id as keyof typeof i.buy.sku];
          const b = buy(id);
          return (
            <a
              class="k-tier"
              href={b.href}
              target={b.target}
              rel={b.rel}
              data-cta="pricing_cta"
              data-plan={id}
            >
              <b>{name}<small>{devices(s.devices)}{b.via ? ` · ${b.via}` : ''}</small></b>
              <em>{price(s)}</em>
              <span class="ms" data-icon="arrow_forward" aria-hidden="true"></span>
            </a>
          );
        })}
      </div>
      <ul class="k-pf">
        <li><span class="ms" data-icon="check" aria-hidden="true"></span><span>{p.lifetime.everything}</span></li>
        <li><span class="ms" data-icon="check" aria-hidden="true"></span><span>{p.lifetime.terms}</span></li>
      </ul>
      <div class="k-contact">{p.contact} <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">{p.contactCta}</a></div>
    </div>
  </div>
  <p class="k-refund"><a href={getLocalizedPath('/refund', lang)}>{p.refund}</a></p>
</section>

<style>
  .k-price { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .k-pc { position: relative; display: flex; flex-direction: column; gap: 16px; padding: 22px 22px 20px; border: 1.5px solid var(--ink); background: rgba(242, 239, 231, 0.95); }
  .k-pc-pop { border-width: 2.5px; box-shadow: 10px 10px 0 var(--grid2); }
  .k-pc-tag { position: absolute; top: -13px; right: 16px; padding: 4px 9px; background: var(--acc); color: #FFFFFF; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .k-pn { font-size: 19px; font-weight: 600; }
  .k-pd { margin-top: 2px; font-size: 14px; color: var(--muted); }
  .k-pp { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; padding-bottom: 16px; border-bottom: 1.5px solid var(--ink); }
  .k-pp b { font-family: var(--font-mono); font-size: 30px; font-weight: 600; letter-spacing: -0.02em; }
  .k-pp span { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .k-pf { list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .k-pf li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 6px; align-items: start; font-size: 14.5px; line-height: 1.45; }
  .k-pf .ms { font-size: 18px; }
  .k-pf .k-px { color: var(--muted); }
  .k-trial { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--acc); }
  .k-trial .ms { font-size: 17px; }
  .k-tiers { display: flex; flex-direction: column; border: 1.5px solid var(--ink); }
  .k-tier { display: grid; grid-template-columns: minmax(0, 1fr) auto 20px; align-items: center; gap: 10px; padding: 10px 12px; background: var(--paper); color: var(--ink); }
  .k-tier + .k-tier { border-top: 1px solid var(--rule); }
  .k-tier:hover { background: var(--ink); color: var(--paper); }
  .k-tier b { font-size: 14.5px; font-weight: 600; }
  .k-tier small { display: block; font-family: var(--font-mono); font-size: 11px; font-weight: 400; color: var(--muted); }
  .k-tier:hover small,
  .k-tier:hover .ms { color: rgba(242, 239, 231, 0.75); }
  .k-tier em { font-style: normal; font-family: var(--font-mono); font-size: 14px; font-weight: 600; }
  .k-tier .ms { font-size: 18px; color: var(--muted); }
  .k-contact { font-size: 13.5px; color: var(--muted); }
  .k-contact a { text-decoration: underline; text-underline-offset: 3px; }
  .k-refund { margin: 24px auto 0; max-width: none; text-align: center; font-family: var(--font-mono); font-size: 12px; }
  .k-refund a { color: var(--muted); }

  @media (max-width: 1080px) {
    .k-price { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; }
  }
</style>
