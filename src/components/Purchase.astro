---
/**
 * Trang mua dùng chung cho /mua và /[lang]/mua. Logic thuần ở
 * `scripts/purchase-core.js`; ở đây chỉ gắn vào DOM và poll trạng thái đơn.
 * Ba đường trả: chuyển khoản VNĐ (QR do SePay vẽ), thẻ (sang trang thanh toán) và
 * USDT TRC20 (địa chỉ ví và số tiền lẻ riêng của đơn, QR vẽ ngay trên trình duyệt).
 * Key license chỉ sống trong biến bộ nhớ và ô nhập — không ghi vào storage/URL.
 */
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";
import { SKUS } from "../data/skus.js";
import { currencyForLang, formatPrice, TELEGRAM_URL, listed } from "../scripts/purchase-core.js";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const b = t(lang).buy;
// Một loại tiền mỗi trang; `?renew=` đổi sang VNĐ ở client (xem payCurrency).
const cur = currencyForLang(lang);
const vnd = cur === "VND";
const groups = ["lifetime", "monthly", "addon"] as const;
const skusOf = (kind: string) =>
  Object.entries(SKUS).filter(([id, s]) => s.kind === kind && listed(id));
---

<section class="buy" id="buy" data-lang={lang} data-i18n={JSON.stringify(b)}>
  <div class="container buy-inner">
    <h1>{b.title}</h1>
    <p class="buy-sub" id="buy-sub">{vnd ? b.subtitleVnd : b.subtitleUsd}</p>

    <form id="buy-form" class="buy-form" novalidate>
      <fieldset class="buy-choose">
        <legend>{b.choose}</legend>
        {
          groups.map((g) => (
            <div class="buy-group">
              <h2>{b.group[g]}</h2>
              <p class="buy-note">{b.note[g]}</p>
              <div class="buy-skus">
                {skusOf(g).map(([id, s]) => (
                  <label class="buy-sku">
                    <input type="radio" name="sku" value={id} data-kind={s.kind} />
                    <span class="buy-sku-name">
                      {b.sku[id as keyof typeof b.sku]}
                    </span>
                    {g === "lifetime" && (
                      <span class="buy-sku-meta">
                        {b.devices.replace("{n}", String(s.devices))}
                      </span>
                    )}
                    <span class="buy-sku-price" data-vnd={s.vnd}
                      >{formatPrice(vnd ? s.vnd : s.usd, cur, lang)}</span
                    >
                  </label>
                ))}
              </div>
            </div>
          ))
        }
      </fieldset>

      <div class="buy-field" id="buy-email-row">
        <label for="buy-email">{b.email}</label>
        <input type="email" id="buy-email" autocomplete="email" required />
        <small>{b.emailHint}</small>
      </div>

      <div class="buy-field" id="buy-key-row" hidden>
        <label for="buy-key">{b.key}</label>
        <div class="buy-key-input">
          <input
            type="password"
            id="buy-key"
            autocomplete="off"
            spellcheck="false"
            placeholder="vl_…"
          />
          <button type="button" class="btn btn-secondary" id="buy-key-toggle"
            >{b.show}</button
          >
        </div>
        <small>{b.keyHint}</small>
      </div>

      <div class="buy-actions">
        <button
          type="button"
          class="btn btn-primary"
          id={vnd ? "buy-vnd" : "buy-usd"}
          data-currency={cur}>{vnd ? b.payVnd : b.payUsd}</button
        >
        {
          !vnd && (
            <button type="button" class="btn btn-secondary" id="buy-usdt" hidden>
              {b.payUsdt}
            </button>
          )
        }
      </div>
      <p class="buy-telegram" id="buy-telegram" hidden>
        {b.telegramOnly}
        <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">{b.telegramCta}</a>
      </p>
      <p class="buy-msg" id="buy-msg" role="alert" aria-live="polite"></p>
    </form>

    <div class="buy-order" id="buy-order" hidden>
      <div id="buy-pending">
        <h2>{b.qrTitle}</h2>
        <img id="buy-qr" alt={b.qrTitle} width="280" height="280" />
        <dl>
          <dt>{b.amount}</dt>
          <dd id="buy-amount"></dd>
          <dt>{b.code}</dt>
          <dd>
            <code id="buy-code"></code>
            <button type="button" class="btn btn-secondary buy-copy" data-copy="buy-code"
              >{b.copy}</button
            >
          </dd>
        </dl>
        <p>{b.expires}</p>
        <p>{b.qrHint}</p>
        <p class="buy-status">{b.waiting}</p>
      </div>
      <div id="buy-usdt-pending" hidden>
        <h2>{b.usdtTitle}</h2>
        <div id="buy-usdt-qr" class="buy-usdt-qr" role="img" aria-label={b.usdtAddress}></div>
        <dl>
          <dt>{b.usdtAddress}</dt>
          <dd>
            <code id="buy-usdt-address"></code>
            <button type="button" class="btn btn-secondary buy-copy" data-copy="buy-usdt-address"
              >{b.copy}</button
            >
          </dd>
          <dt>{b.usdtAmount}</dt>
          <dd>
            <code id="buy-usdt-amount"></code> USDT
            <button type="button" class="btn btn-secondary buy-copy" data-copy="buy-usdt-amount"
              >{b.copy}</button
            >
          </dd>
        </dl>
        <p><strong>{b.usdtNetworkWarn}</strong></p>
        <p>{b.usdtExactWarn}</p>
        <p>{b.expires}</p>
        <p id="buy-usdt-countdown-row" hidden>
          {b.usdtTimeLeft} <code id="buy-usdt-countdown" role="timer"></code>
        </p>
        <p class="buy-status">{b.usdtWaiting}</p>
      </div>
      <div id="buy-paid-key" hidden>
        <p>{b.paidKey}</p>
        <p>
          <code id="buy-new-key"></code>
          <button type="button" class="btn btn-secondary buy-copy" data-copy="buy-new-key"
            >{b.copy}</button
          >
        </p>
        <p>{b.paidKeyHint}</p>
      </div>
      <p id="buy-paid-added" hidden>{b.paidAdded}</p>
      <div id="buy-expired" hidden>
        <p>{b.expired}</p>
        <button type="button" class="btn btn-primary" id="buy-new-order"
          >{b.newOrder}</button
        >
      </div>
    </div>
  </div>
</section>

<script>
  import qrcode from "qrcode-generator";
  import {
    API_BASE,
    parseQuery,
    needsKey,
    formRequiresKey,
    buildOrderBody,
    errorKey,
    safeCheckoutUrl,
    pollDelay,
    hasValidAmount,
    payCurrency,
    formatPrice,
    payRoute,
    listed,
    usdtShown,
    countdownText,
  } from "../scripts/purchase-core.js";

  const STORE = "veilus-order"; // chỉ id + dữ liệu hiển thị của đơn, KHÔNG key

  const root = document.getElementById("buy") as HTMLElement;
  const dict = JSON.parse(root.dataset.i18n || "{}");
  const lang = root.dataset.lang || "en";
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const tr = (k: string): string =>
    k
      .replace(/^buy\./, "")
      .split(".")
      .reduce((o: any, p) => o?.[p], dict) ?? dict.err.generic;

  // 1. Key ra khỏi thanh địa chỉ trước mọi việc khác — giữ lại `renew=1` (không
  // key) để tải lại trang vẫn nhận ra đang ở luồng gia hạn (xem parseQuery).
  const q = parseQuery(location.search);
  if (q.askKey) {
    const params = new URLSearchParams();
    if (q.sku) params.set("sku", q.sku);
    params.set("renew", "1");
    // Thiếu dòng này thì tải lại trang mất `method=usdt` và mua thêm máy bằng USDT rơi về luồng VNĐ.
    if (q.method) params.set("method", q.method);
    history.replaceState(null, "", location.pathname + "?" + params.toString());
  }

  const form = $("buy-form") as HTMLFormElement;
  const payBtn = form.querySelector(".buy-actions button") as HTMLButtonElement;
  const usdtBtn = document.getElementById("buy-usdt") as HTMLButtonElement | null;
  const currency = payCurrency(lang, q);
  // Trang tiếng khác mở bằng ?renew= (key thuê tháng VNĐ từ app): chuyển trang sang luồng VNĐ.
  // Chỉ khi ra VNĐ: loại tiền USDT (`method=usdt`) vẫn là trang USD, nút trả thẻ giữ nguyên.
  if (currency === "VND" && payBtn.dataset.currency !== "VND") {
    payBtn.id = "buy-vnd";
    payBtn.dataset.currency = currency;
    payBtn.textContent = dict.payVnd;
    $("buy-sub").textContent = dict.subtitleVnd;
    form.querySelectorAll<HTMLElement>(".buy-sku-price").forEach((el) => {
      el.textContent = formatPrice(Number(el.dataset.vnd), "VND", lang);
    });
  }
  const emailEl = $("buy-email") as HTMLInputElement;
  const emailRow = $("buy-email-row");
  const keyRow = $("buy-key-row");
  const keyEl = $("buy-key") as HTMLInputElement;
  const msg = $("buy-msg");
  const radios = [...form.querySelectorAll<HTMLInputElement>('input[name="sku"]')];

  const selectedSku = () => radios.find((r) => r.checked)?.value ?? "solo";
  const showErr = (k: string) => (msg.textContent = tr(k));

  function syncKeyRow() {
    const sku = selectedSku();
    keyRow.hidden = !needsKey(sku, true);
    keyEl.required = formRequiresKey(sku, q);
  }

  const telegramRow = $("buy-telegram");
  /**
   * Nút trả theo gói và loại tiền (payRoute, usdtShown): nút thẻ/VNĐ hiện khi đường trả là thẻ hoặc VNĐ,
   * nút USDT hiện khi gói bán qua USDT — trang USD có thể hiện cả hai; `method=usdt` chỉ còn nút USDT.
   * Không nút nào thì chỉ còn đường Telegram: ẩn luôn ô email và ô key vì không có gì để gửi.
   */
  function syncPayRow() {
    const sku = selectedSku();
    const route = payRoute(currency, sku);
    const card = route === "card" || route === "vnd";
    const usdt = usdtShown(currency, sku);
    const telegramOnly = !card && !usdt;
    payBtn.hidden = !card;
    if (usdtBtn) {
      usdtBtn.hidden = !usdt;
      // Không còn nút thẻ thì nút USDT là nút chính của form.
      usdtBtn.classList.toggle("btn-primary", !card);
      usdtBtn.classList.toggle("btn-secondary", card);
    }
    telegramRow.hidden = !telegramOnly;
    emailRow.hidden = telegramOnly;
    // onSkuChange chạy syncKeyRow trước nên dòng này thắng; đổi sang gói có nút trả thì syncKeyRow trả ô key lại.
    if (telegramOnly) keyRow.hidden = true;
    // Phụ đề nói "trả bằng thẻ / chuyển khoản": không đúng khi chỉ còn đường Telegram hay chỉ còn nút USDT.
    $("buy-sub").hidden = !card;
  }

  // Gói đang ẩn (vd ?sku=team10 từ link cũ) không có ô chọn: về mặc định thay vì để trống.
  const initial = (q.sku && listed(q.sku) ? q.sku : null) ?? (q.askKey ? "monthly" : "solo");
  const onSkuChange = () => {
    syncKeyRow();
    syncPayRow();
  };
  radios.forEach((r) => {
    r.checked = r.value === initial;
    r.addEventListener("change", onSkuChange);
  });
  if (q.licenseKey) keyEl.value = q.licenseKey;
  onSkuChange();

  $("buy-key-toggle").addEventListener("click", (e) => {
    const show = keyEl.type === "password";
    keyEl.type = show ? "text" : "password";
    (e.currentTarget as HTMLElement).textContent = show ? dict.hide : dict.show;
  });

  document.querySelectorAll<HTMLButtonElement>(".buy-copy").forEach((btn) =>
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText($(btn.dataset.copy!).textContent || "");
        btn.textContent = dict.copied;
      } catch {
        /* trình duyệt chặn clipboard: người dùng vẫn chép tay được */
      }
    }),
  );

  /** POST JSON; lỗi mạng hiện `buy.err.network` và trả null. */
  async function post(path: string, body: object) {
    try {
      const res = await fetch(`${API_BASE}${path}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => ({}));
      return { res, data };
    } catch {
      showErr("buy.err.network");
      return null;
    }
  }

  function readForm() {
    const sku = selectedSku();
    const key = keyRow.hidden ? "" : keyEl.value.trim();
    if (formRequiresKey(sku, q) && !key) return null;
    return { sku, email: emailEl.value.trim(), licenseKey: key || null, lang };
  }

  async function withBusy(fn: () => Promise<void>) {
    const btns = form.querySelectorAll<HTMLButtonElement>(".buy-actions button");
    btns.forEach((b) => (b.disabled = true));
    msg.textContent = "";
    try {
      await fn();
    } finally {
      btns.forEach((b) => (b.disabled = false));
    }
  }

  async function payVnd() {
    const f = readForm();
    if (!f || !f.email || !emailEl.checkValidity()) return void showErr("buy.err.input");
    const r = await post("/api/v1/orders", buildOrderBody(f));
    if (!r) return;
    if (
      r.res.status !== 201 ||
      typeof r.data.id !== "string" ||
      !hasValidAmount(r.data.amount)
    ) {
      return void showErr(errorKey(r.res.status, r.data.code));
    }
    const order = {
      id: r.data.id,
      code: r.data.code,
      amount: r.data.amount,
      qr_url: r.data.qr_url,
    };
    try {
      sessionStorage.setItem(STORE, JSON.stringify(order));
    } catch {
      /* storage bị chặn: tải lại trang thì mất theo dõi, đơn vẫn còn */
    }
    showOrder(order);
  }

  async function payUsd() {
    const f = readForm();
    if (!f || (f.email && !emailEl.checkValidity())) return void showErr("buy.err.input");
    const r = await post("/api/v1/checkout", buildOrderBody(f));
    if (!r) return;
    if (!r.res.ok) return void showErr(errorKey(r.res.status, r.data.code));
    const url = safeCheckoutUrl(r.data.url);
    if (!url) return void showErr("buy.err.generic");
    location.assign(url);
  }

  payBtn.addEventListener("click", () => withBusy(currency === "VND" ? payVnd : payUsd));

  type UsdtOrder = {
    id: string;
    method: "usdt";
    amount: number; // phần triệu USDT, như trong D1
    amount_usdt: string; // chuỗi để hiện, ví dụ "99.0173"
    address: string;
    expires_at: string | null; // ISO; GET /orders/:id không trả lại, nên giữ ở đây cho đồng hồ sau khi tải lại trang
  };

  async function payUsdt() {
    const f = readForm();
    if (!f || !f.email || !emailEl.checkValidity()) return void showErr("buy.err.input");
    const r = await post("/api/v1/orders", buildOrderBody({ ...f, method: "usdt" }));
    if (!r) return;
    const d = r.data;
    if (
      r.res.status !== 201 ||
      typeof d.id !== "string" ||
      !hasValidAmount(d.amount) ||
      typeof d.amount_usdt !== "string" ||
      !d.amount_usdt ||
      typeof d.address !== "string" ||
      !d.address
    ) {
      return void showErr(errorKey(r.res.status, d.code));
    }
    const order: UsdtOrder = {
      id: d.id,
      method: "usdt",
      amount: d.amount,
      amount_usdt: d.amount_usdt,
      address: d.address,
      expires_at: typeof d.expires_at === "string" ? d.expires_at : null,
    };
    try {
      sessionStorage.setItem(STORE, JSON.stringify(order));
    } catch {
      /* storage bị chặn: tải lại trang thì mất theo dõi, đơn vẫn còn */
    }
    showUsdtOrder(order);
  }

  usdtBtn?.addEventListener("click", () => withBusy(payUsdt));

  type Order = { id: string; code: string; amount: number; qr_url: string };

  function show(id: string, on: boolean) {
    $(id).hidden = !on;
  }

  function showOrder(o: Order) {
    form.hidden = true;
    show("buy-order", true);
    show("buy-pending", true);
    show("buy-usdt-pending", false);
    ["buy-paid-key", "buy-paid-added", "buy-expired"].forEach((id) => show(id, false));
    const qr = safeCheckoutUrl(o.qr_url);
    if (qr) ($("buy-qr") as HTMLImageElement).src = qr;
    $("buy-amount").textContent = formatPrice(o.amount, "VND", lang);
    $("buy-code").textContent = o.code;
    poll(o.id);
  }

  /** QR chỉ chứa địa chỉ ví; số tiền khách chép (mỗi ví đọc số tiền trong QR một kiểu). */
  function renderQr(el: HTMLElement, text: string) {
    try {
      const qr = qrcode(0, "M");
      qr.addData(text);
      qr.make();
      el.innerHTML = qr.createSvgTag({ cellSize: 5, margin: 2, scalable: true });
    } catch (e) {
      // Không vẽ được thì bỏ khung QR; địa chỉ vẫn hiện bằng chữ để chép.
      el.replaceChildren();
      console.error("buy: không vẽ được QR", e);
    }
  }

  // Đồng hồ của màn USDT tính lại từ `expires_at` mỗi giây, không cộng dồn — tab ngủ xong vẫn đúng.
  // Hạn thật do máy chủ giữ: hết giờ thì poll thấy `expired` và đổi màn; ở đây chỉ hiện thời gian còn lại.
  let clock: ReturnType<typeof setInterval> | undefined;

  function startCountdown(expiresAt: string | null | undefined) {
    clearInterval(clock);
    const row = $("buy-usdt-countdown-row");
    const out = $("buy-usdt-countdown");
    const paint = () => {
      const text = countdownText(expiresAt);
      row.hidden = text === null; // không đọc được hạn thì ẩn dòng đồng hồ, không hiện giờ sai
      if (text !== null) out.textContent = text;
    };
    paint();
    clock = setInterval(paint, 1000);
  }

  function showUsdtOrder(o: UsdtOrder) {
    form.hidden = true;
    show("buy-order", true);
    show("buy-pending", false);
    show("buy-usdt-pending", true);
    ["buy-paid-key", "buy-paid-added", "buy-expired"].forEach((id) => show(id, false));
    $("buy-usdt-address").textContent = o.address;
    $("buy-usdt-amount").textContent = o.amount_usdt;
    renderQr($("buy-usdt-qr"), o.address);
    startCountdown(o.expires_at);
    poll(o.id);
  }

  function clearStore() {
    try {
      sessionStorage.removeItem(STORE);
    } catch {
      /* không có gì để dọn */
    }
  }

  // Đơn đã trả vẫn giữ id trong sessionStorage để tải lại còn hỏi lại được
  // key (GET /orders/:id); chỉ xoá khi hết hạn/404 hoặc người dùng bấm "đơn mới".
  function finish(clear: boolean) {
    if (clear) clearStore();
    show("buy-pending", false);
    show("buy-usdt-pending", false);
    clearInterval(clock);
  }

  let timer: ReturnType<typeof setTimeout> | undefined;
  let pollGen = 0; // huỷ hiệu lực response của vòng poll cũ khi vòng mới đã bắt đầu

  function poll(id: string) {
    const gen = ++pollGen;
    let last: string | null = null;
    let changedAt = Date.now();
    const tick = async () => {
      let d: any = null;
      try {
        const res = await fetch(`${API_BASE}/api/v1/orders/${encodeURIComponent(id)}`);
        if (res.status === 404) d = { status: "expired" };
        else if (res.ok) d = await res.json();
      } catch {
        /* mất mạng tạm thời: poll tiếp */
      }
      if (gen !== pollGen) return; // vòng poll khác đã thay thế vòng này
      if (d) {
        if (d.status !== last) {
          last = d.status;
          changedAt = Date.now();
        }
        if (d.status === "paid") {
          finish(false);
          if (typeof d.key === "string" && d.key) {
            $("buy-new-key").textContent = d.key;
            show("buy-paid-key", true);
          } else show("buy-paid-added", true);
          return;
        }
        if (d.status === "expired") {
          finish(true);
          show("buy-expired", true);
          return;
        }
      }
      timer = setTimeout(tick, pollDelay(Date.now() - changedAt));
    };
    clearTimeout(timer);
    tick();
  }

  $("buy-new-order").addEventListener("click", () => {
    clearStore();
    clearInterval(clock);
    show("buy-order", false);
    form.hidden = false;
  });

  // 6. Tải lại trang vẫn theo dõi đơn đang chờ.
  try {
    const saved = JSON.parse(sessionStorage.getItem(STORE) || "null");
    if (saved && typeof saved.id === "string" && hasValidAmount(saved.amount)) {
      if (saved.method !== "usdt") showOrder(saved);
      else if (typeof saved.address === "string" && typeof saved.amount_usdt === "string") showUsdtOrder(saved);
      else clearStore(); // bản ghi USDT hỏng (thiếu địa chỉ hoặc số tiền) — bỏ, quay lại form
    } else if (saved) {
      clearStore(); // bản ghi hỏng (amount thiếu/NaN) — bỏ, quay lại form
    }
  } catch {
    /* storage bị chặn hoặc hỏng: bắt đầu từ form */
  }
</script>

<style>
  /* `display` bên dưới đè thuộc tính `hidden` nếu không có dòng này */
  .buy [hidden] {
    display: none !important;
  }
  .buy {
    padding: calc(var(--nav-height) + var(--space-2xl)) 0 var(--space-3xl);
  }
  .buy-inner {
    max-width: 880px;
  }
  .buy h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: var(--space-sm);
  }
  .buy-sub {
    margin-bottom: var(--space-xl);
  }
  .buy-choose {
    border: none;
  }
  .buy-choose legend {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }
  .buy-group {
