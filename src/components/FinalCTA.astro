---
/**
 * Lời mời cuối trang chủ (spec trang chủ §4 dòng 10).
 */
import type { Lang } from '../i18n/utils';
import { t, defaultLang, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang || defaultLang;
const h = t(lang).home;
const f = h.final;
---

<section class="k-wrap k-final" id="download" data-reveal>
  <div class="k-fig"><b>{f.figNo}</b> — {f.fig}</div>
  <h2 class="k-h2">{f.title}</h2>
  <div class="k-cta k-rise" style="--d:0.1s">
    <a class="k-btn" href={getLocalizedPath('/download', lang)} data-cta="final_cta">{h.cta}</a>
    <span class="k-micro">{f.micro}</span>
  </div>
</section>

<style>
  .k-final { padding-block: 110px; }
  .k-final .k-h2 { margin-bottom: 26px; }
</style>
