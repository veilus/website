---
import type { Lang } from '../i18n/utils';
import { t, defaultLang } from '../i18n/utils';
interface Props { lang?: Lang; }
const lang = Astro.props.lang || defaultLang;
const i = t(lang);
// Thứ tự thẻ theo i18n: MMO/mạng xã hội, quảng cáo/affiliate, TMĐT, lập trình viên.
const icons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
];
const colors = ['var(--color-cyan)', 'var(--color-gold-light)', 'var(--color-success)', 'var(--color-indigo)'];
---
<section class="section audience" id="use-cases" data-animate>
  <div class="container">
    <div class="section-header">
      <span class="badge">{i.audience.badge}</span>
      <h2 class="mt-md">{i.audience.title} <span class="text-gradient">{i.audience.titleHighlight}</span></h2>
      <p>{i.audience.subtitle}</p>
    </div>
    <div class="audience-grid">
      {i.audience.items.map((item, idx) => (
        <div class="audience-card card" style={`--accent: ${colors[idx]}`}>
          <div class="audience-head">
            <div class="audience-icon" set:html={icons[idx]} />
            <h3 class="audience-title">{item.title}</h3>
          </div>
          <p class="audience-outcome">{item.outcome}</p>
          <ul class="audience-features">
            {item.features.map((f) => <li><span class="check" aria-hidden="true">✓</span>{f}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .audience { background: var(--bg-surface); }
  .audience-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-lg); }
  .audience-card { display: flex; flex-direction: column; gap: var(--space-md); cursor: default; background: var(--bg-primary); }
  .audience-card:hover { border-color: var(--accent); }
  .audience-head { display: flex; align-items: center; gap: var(--space-sm); }
  .audience-icon { width: 40px; height: 40px; padding: 8px; flex-shrink: 0; border-radius: var(--radius-md); background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--accent); display: flex; align-items: center; justify-content: center; }
  .audience-icon :global(svg) { width: 24px; height: 24px; }
  .audience-title { font-size: 1.125rem; font-weight: 700; }
  .audience-outcome { font-size: 1rem; line-height: 1.6; color: var(--color-text); }
  .audience-features { list-style: none; display: flex; flex-direction: column; gap: var(--space-xs); }
  .audience-features li { display: flex; align-items: flex-start; gap: var(--space-sm); font-size: 0.9375rem; color: var(--color-text-secondary); }
  .check { width: 18px; flex-shrink: 0; color: var(--color-success); font-weight: 700; }
  @media (max-width: 768px) { .audience-grid { grid-template-columns: 1fr; } }
</style>
