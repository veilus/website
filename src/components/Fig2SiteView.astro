---
/**
 * Hình 2 — trang web thấy gì (spec trang chủ §4 dòng 2). Trình duyệt thường: 4 tài khoản chung một
 * fingerprint, một IP. Veilus: mỗi tài khoản một fingerprint, một proxy. Mã fingerprint, mã nước là minh hoạ.
 */
import type { Lang } from '../i18n/utils';
import { t, defaultLang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang || defaultLang;
const f = t(lang).home.fig2;
const OWN = [
  { fp: '7a3e', cc: 'VN' },
  { fp: 'c019', cc: 'SG' },
  { fp: '4b8d', cc: 'TH' },
  { fp: 'e21f', cc: 'MY' },
];
const account = (n: number) => f.account.replace('{n}', String(n));
const delay = (s: number) => `--d:${s.toFixed(2)}s`;
---

<section class="k-wrap k-sec" id="anti-detect" data-reveal>
  <div class="k-fig"><b>{f.figNo}</b> — {f.fig}</div>
  <h2 class="k-h2">{f.title}</h2>
  <div class="k-vs">
    <div class="k-panel">
      <div class="k-ptag"><span class="ms" aria-hidden="true">close</span>{f.plain}</div>
      <div class="k-dev"><span class="ms" aria-hidden="true">laptop_mac</span><small>{f.machine}</small></div>
      <div class="k-drop"></div>
      <div class="k-accs">
        {OWN.map((_, n) => (
          <div class="k-acc k-rise" style={delay(0.2 + n * 0.1)}>
            <div class="k-wbar"><i></i><i></i><i></i></div>
            <b><span class="ms" aria-hidden="true">account_circle</span>{account(n + 1)}</b>
          </div>
        ))}
      </div>
      <div class="k-join k-draw-down" style={delay(0.8)}></div>
      <div class="k-chip k-chip-bad k-pop" style={delay(1.2)}><span class="ms" aria-hidden="true">fingerprint</span>{f.shared}</div>
      <div class="k-drop k-draw-down" style={delay(1.4)}></div>
      <div class="k-site k-rise" style={delay(1.5)}><span class="ms" aria-hidden="true">storefront</span>{f.site}</div>
      <div class="k-verdict k-v-bad k-rise" style={delay(1.75)}>
        <span class="ms" aria-hidden="true">link</span>
        <div><b>{f.badTitle}</b><small>{f.badSub}</small></div>
      </div>
    </div>

    <div class="k-panel">
      <div class="k-ptag k-ptag-good"><span class="ms" aria-hidden="true">check</span>Veilus</div>
      <div class="k-dev"><span class="ms" aria-hidden="true">laptop_mac</span><small>{f.machineVeilus}</small></div>
      <div class="k-drop"></div>
      <div class="k-accs">
        {OWN.map((o, n) => (
          <div class="k-own">
            <div class="k-acc k-rise" style={delay(0.2 + n * 0.1)}>
              <div class="k-wbar"><i></i><i></i><i></i></div>
              <b><span class="ms" aria-hidden="true">account_circle</span>{account(n + 1)}</b>
            </div>
            <div class="k-tick k-draw-down" style={delay(0.8 + n * 0.1)}></div>
            <div class="k-chip k-pop" style={delay(1.0 + n * 0.1)}><span class="ms" aria-hidden="true">fingerprint</span>{o.fp}</div>
            <div class="k-chip k-pop" style={delay(1.1 + n * 0.1)}><span class="ms" aria-hidden="true">vpn_lock</span>{o.cc}</div>
          </div>
        ))}
      </div>
      <div class="k-drop k-draw-down" style={delay(1.5)}></div>
      <div class="k-site k-rise" style={delay(1.6)}><span class="ms" aria-hidden="true">storefront</span>{f.site}</div>
      <div class="k-verdict k-v-good k-rise" style={delay(1.85)}>
        <span class="ms" aria-hidden="true">link_off</span>
        <div><b>{f.goodTitle}</b><small>{f.goodSub}</small></div>
      </div>
    </div>
  </div>
</section>

<style>
  .k-vs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; }
  .k-panel { position: relative; display: flex; flex-direction: column; align-items: center; padding: 26px 26px 24px; border: 1.5px solid var(--ink); background: rgba(242, 239, 231, 0.92); }
  .k-ptag { position: absolute; top: -1.5px; left: -1.5px; display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1.5px solid var(--ink); background: var(--paper); font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .k-ptag .ms { font-size: 16px; }
  .k-ptag-good { background: var(--ink); color: var(--paper); }
  .k-accs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; width: 100%; }
  .k-own { display: flex; flex-direction: column; align-items: center; }
  .k-acc { width: 100%; border: 1.5px solid var(--ink); background: var(--paper); }
  .k-acc b { display: flex; align-items: center; justify-content: center; gap: 5px; padding: 8px 4px; font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; }
  .k-tick { width: 0; height: 14px; border-left: 1.5px solid var(--ink); }
  .k-own .k-chip { margin-bottom: 4px; padding: 3px 6px; font-size: 10.5px; }
  .k-join { position: relative; width: 76%; height: 22px; margin-bottom: 14px; border: 1.5px solid var(--ink); border-top: 0; }
  .k-join::after { content: ''; position: absolute; left: 50%; bottom: -15px; height: 14px; border-left: 1.5px solid var(--ink); }
  .k-chip-bad { background: repeating-linear-gradient(45deg, rgba(27, 34, 48, 0.14) 0 1px, transparent 1px 6px), var(--paper); }
  .k-site { display: flex; align-items: center; gap: 8px; padding: 9px 14px; border: 1.5px solid var(--ink); background: var(--paper); font-size: 14px; font-weight: 600; }
  .k-verdict { display: flex; align-items: center; gap: 14px; width: 100%; margin-top: 16px; padding: 14px 16px; border: 1.5px solid var(--ink); }
  .k-verdict .ms { font-size: 30px; }
  .k-verdict b { display: block; font-size: 17px; }
  .k-verdict small { font-size: 13.5px; }
  .k-v-bad { background: repeating-linear-gradient(45deg, rgba(27, 34, 48, 0.12) 0 1px, transparent 1px 7px), var(--paper); }
  .k-v-good { background: var(--ink); color: var(--paper); }
  .k-v-good small { color: rgba(242, 239, 231, 0.75); }

  @media (max-width: 1080px) {
    .k-vs { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .k-accs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .k-panel { padding: 30px 14px 16px; }
  }
</style>
