---
/**
 * Trang /features/mcp/, dùng chung cho en và /[lang]/ (VEIL-1314): trang đích cho truy vấn về MCP, thứ trước đây
 * chỉ là một mục trên trang chủ. Hình vòng lặp là Fig4McpLoop ở chế độ page (H1); phần kết nối chép lệnh từ
 * docs reference/mcp — docs là nguồn, đổi lệnh ở đó thì sửa đây.
 */
import type { Lang } from '../i18n/utils';
import { t } from '../i18n/utils';
import Navbar from './Navbar.astro';
import Fig4McpLoop from './Fig4McpLoop.astro';
import FinalCTA from './FinalCTA.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const m = t(lang).mcpPage;
const DOCS_MCP = 'https://docs.veilus.io/reference/mcp/';
const CLAUDE_CODE = 'claude mcp add --scope user veilus -e VEILUS_API_TOKEN=<token> -- "<path to Veilus>" mcp';
// Video demo film 55 giây trên kênh YouTube @veilusbrowser (VEIL-1348): bản tiếng Việt (giọng VieNeu) cho /vi/,
// bản tiếng Anh (giọng Kokoro) cho các ngôn ngữ còn lại. Ảnh bìa là khung giây 49,6 của file gốc, tự host:
// trang không gọi YouTube cho tới khi người xem bấm phát.
const VIDEO = lang === 'vi'
  ? { id: 'Zyt34L6yZ2k', poster: '/video/mcp-demo-poster-vi.jpg', name: 'Một câu lệnh, nhiều trình duyệt: trợ lý AI điều khiển Veilus qua MCP' }
  : { id: '8NRDNW_4KNU', poster: '/video/mcp-demo-poster-en.jpg', name: 'One sentence, many browsers: an AI assistant drives Veilus over MCP' };
const videoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: VIDEO.name,
  description: m.pageLead,
  thumbnailUrl: new URL(VIDEO.poster, Astro.site).href,
  uploadDate: '2026-10-11',
  duration: 'PT55S',
  embedUrl: `https://www.youtube-nocookie.com/embed/${VIDEO.id}`,
  url: `https://www.youtube.com/watch?v=${VIDEO.id}`,
};
const CLIENT_JSON = `{
  "mcpServers": {
    "veilus": {
      "command": "<path to Veilus>",
      "args": ["mcp"],
      "env": { "VEILUS_API_TOKEN": "<token>" }
    }
  }
}`;
---

<Navbar lang={lang} />
<main>
  <Fig4McpLoop lang={lang} page />

  <section class="k-wrap k-sec" id="demo" data-reveal>
    <h2 class="k-h2">{m.videoTitle}</h2>
    <div class="k-video">
      <button type="button" class="k-play" data-video={VIDEO.id} aria-label={m.videoPlay}>
        <img src={VIDEO.poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />
        <span class="ms" data-icon="play_circle" aria-hidden="true"></span>
      </button>
    </div>
    <p class="k-note">{m.videoNote}</p>
    <script type="application/ld+json" set:html={JSON.stringify(videoJsonLd)}></script>
  </section>

  <section class="k-wrap k-sec" id="connect" data-reveal>
    <h2 class="k-h2">{m.connectTitle}</h2>
    <p class="k-sub">{m.connectLead}</p>
    <div class="k-snips">
      <div class="k-snip k-rise" style="--d:0.1s">
        <div class="k-fig">Claude Code</div>
        <pre class="k-code">{CLAUDE_CODE}</pre>
      </div>
      <div class="k-snip k-rise" style="--d:0.2s">
        <div class="k-fig">{m.otherClients}</div>
        <pre class="k-code">{CLIENT_JSON}</pre>
      </div>
    </div>
    <p class="k-docs"><a href={DOCS_MCP}>{m.docsCta}</a></p>
  </section>

  <section class="k-wrap k-sec" id="capabilities" data-reveal>
    <h2 class="k-h2">{m.capTitle}</h2>
    <ul class="k-caps">
      {m.caps.map((c, n) => (
        <li class="k-rise" style={`--d:${(0.1 + n * 0.08).toFixed(2)}s`}>
          <em>{String(n + 1).padStart(2, '0')}</em><span>{c}</span>
        </li>
      ))}
    </ul>
    <p class="k-safety"><span class="ms" data-icon="lock" aria-hidden="true"></span>{m.safety}</p>
  </section>

  <FinalCTA lang={lang} />
</main>
<Footer lang={lang} />

<script>
  // Facade: thay nút bằng iframe youtube-nocookie chỉ khi người xem bấm.
  document.querySelectorAll<HTMLButtonElement>('.k-play[data-video]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.video}?autoplay=1&rel=0`;
      frame.title = btn.getAttribute('aria-label') ?? '';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      btn.replaceWith(frame);
    });
  });
</script>

<style>
  .k-video { position: relative; aspect-ratio: 16 / 9; border: 1.5px solid var(--ink); background: #000; }
  .k-video :global(iframe), .k-play { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; padding: 0; background: none; cursor: pointer; }
  .k-play img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .k-play .ms { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-size: 72px; color: #fff; opacity: 0.9; }
  .k-play:hover .ms, .k-play:focus-visible .ms { opacity: 1; }
  .k-note { margin-top: 10px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .k-snips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .k-snip { display: flex; flex-direction: column; gap: 10px; padding: 18px; border: 1.5px solid var(--ink); background: rgba(242, 239, 231, 0.95); }
  .k-snip .k-code { white-space: pre-wrap; word-break: break-word; font-size: 12.5px; line-height: 1.5; }
  .k-docs { margin-top: 20px; font-family: var(--font-mono); font-size: 12.5px; }
  .k-docs a { text-decoration: underline; text-underline-offset: 3px; }
  .k-caps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; margin: 0; padding: 0; list-style: none; border-top: 1.5px solid var(--ink); }
  .k-caps li { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 8px; padding: 14px 0; border-bottom: 1px solid var(--rule); font-size: 15px; line-height: 1.5; }
  .k-caps em { font-style: normal; font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--acc); padding-top: 3px; }
  .k-safety { display: flex; align-items: flex-start; gap: 8px; margin-top: 22px; max-width: 64ch; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.55; color: var(--muted); }
  .k-safety .ms { font-size: 18px; flex: none; }

  @media (max-width: 860px) {
    .k-snips, .k-caps { grid-template-columns: 1fr; }
  }
</style>
