---
/**
 * Hình 3 — giải phẫu một hồ sơ (spec trang chủ §4 dòng 3). Số trường fingerprint đọc từ data/facts.js;
 * giá trị trong các nhãn là minh hoạ một hồ sơ ở Tokyo. Đường chỉ dẫn vẽ từ cửa sổ ra nhãn; số đếm lên từ 0.
 */
import type { Lang } from '../i18n/utils';
import { t, defaultLang } from '../i18n/utils';
import { FINGERPRINT_FIELDS } from '../data/facts.js';

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang || defaultLang;
const h = t(lang).home;
const f = h.fig3;
const delay = (s: number) => `--d:${s.toFixed(2)}s`;
---

<section class="k-wrap k-sec" id="profile" data-reveal>
  <div class="k-fig"><b>{f.figNo}</b> — {f.fig}</div>
  <h2 class="k-h2">{f.title}</h2>
  <div class="k-anat">
    <div class="k-side k-side-l">
      {f.left.map((l, n) => (
        <div class="k-lbl">
          <div class="k-lt k-rise" style={delay(0.9 + n * 0.12)}><b>{l.t}</b><code>{l.v}</code></div>
          <div class="k-ldr k-draw-l" style={delay(0.45 + n * 0.12)}></div>
        </div>
      ))}
    </div>
    <div class="k-big k-rise" style={delay(0.1)}>
      <div class="k-big-bar"><i></i><i></i><i></i><span>{h.profileName} · JP · TOKYO</span></div>
      <div class="k-big-url"><span class="ms" aria-hidden="true">lock</span>shop.example.jp</div>
      <div class="k-big-bd">
        <span class="ms k-big-fp" aria-hidden="true">fingerprint</span>
        <div class="k-stat k-pop" style={delay(0.35)}>
          <b data-count-to={FINGERPRINT_FIELDS}>{FINGERPRINT_FIELDS}</b>
          <span>{f.fields}<br />{f.patched}</span>
        </div>
      </div>
    </div>
    <div class="k-side k-side-r">
      {f.right.map((r, n) => (
        <div class="k-lbl">
          <div class="k-ldr k-draw" style={delay(0.45 + n * 0.12)}></div>
          <div class="k-lt k-rise" style={delay(0.9 + n * 0.12)}><b>{r.t}</b><code>{r.v}</code></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .k-anat { display: grid; grid-template-columns: minmax(0, 1fr) 380px minmax(0, 1fr); align-items: center; }
  .k-side { display: flex; flex-direction: column; gap: 18px; }
  .k-lbl { display: flex; align-items: center; }
  .k-lt b { display: block; font-size: 14.5px; font-weight: 600; }
  .k-lt code { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .k-side-l .k-lt { text-align: right; }
  .k-ldr { position: relative; flex: 1; min-width: 28px; height: 0; margin: 0 10px; border-top: 1px dashed var(--ink); }
  .k-side-l .k-ldr::after,
  .k-side-r .k-ldr::before { content: ''; position: absolute; top: -4px; width: 7px; height: 7px; border-radius: 50%; background: var(--acc); }
  .k-side-l .k-ldr::after { right: -4px; }
  .k-side-r .k-ldr::before { left: -4px; }
  .k-big { border: 1.5px solid var(--ink); background: var(--paper); box-shadow: 10px 10px 0 var(--grid2); }
  .k-big-bar { display: flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; border-bottom: 1.5px solid var(--ink); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; }
  .k-big-bar i { display: block; width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid var(--ink); }
  .k-big-bar > span { margin-left: 10px; }
  .k-big-url { display: flex; align-items: center; gap: 6px; margin: 10px 12px; padding: 6px 10px; border: 1px solid var(--rule); font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); }
  .k-big-url .ms { font-size: 15px; }
  .k-big-bd { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 18px 20px 30px; }
  .k-big-fp { font-size: 120px; color: var(--ink); font-variation-settings: 'FILL' 0, 'wght' 200, 'GRAD' 0, 'opsz' 48; }
  .k-stat { display: flex; align-items: center; gap: 14px; }
  .k-stat b { font-size: 56px; font-weight: 700; line-height: 1; color: var(--acc); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .k-stat > span { font-family: var(--font-mono); font-size: 12px; line-height: 1.5; color: var(--muted); }

  @media (max-width: 1080px) {
    .k-anat { grid-template-columns: 1fr; gap: 28px; }
    .k-big { order: -1; justify-self: center; width: 100%; max-width: 380px; }
    .k-side-l .k-lt { text-align: left; }
    .k-side-l .k-lbl { flex-direction: row-reverse; }
    .k-side-l .k-ldr::after { right: auto; left: -4px; }
    .k-ldr { flex: 0 0 28px; }
  }
</style>
