---
import type { Lang } from '../i18n/utils';
import { t, defaultLang } from '../i18n/utils';
import { SKUS } from '../data/skus.js';
import { currencyForLang, formatPrice } from '../scripts/purchase-core.js';
import competitors from '../data/competitors.json';
interface Props { lang?: Lang; }
const lang = Astro.props.lang || defaultLang;
const i = t(lang);
const c = i.comparison;
// Giá trong bảng so sánh lấy từ SKUS để không lệch với trang giá.
// Một loại tiền mỗi ngôn ngữ, như trang giá.
// Cột đối thủ: MỘT nguồn là src/data/competitors.json (url + trích nguyên văn + ngày đọc cho từng ô,
// chỉ trang chính thức của hãng). Ô null = chưa kiểm chứng → "—", không phải "không" (VEIL-955).
const cur = currencyForLang(lang);
const price = (s: { vnd: number; usd: number }) => formatPrice(cur === 'VND' ? s.vnd : s.usd, cur, lang);
const fillPrices = (v: string) => v.replace('{monthly}', price(SKUS.monthly)).replace('{lifetime}', price(SKUS.solo));
type Params = Record<string, string | number>;
// paramsByLang: hãng niêm yết giá riêng cho một ngôn ngữ (GPM Login: /vi ghi VNĐ) — kèm url + trích riêng trong competitors.json.
type Cell = { key: keyof typeof i.comparison.cells; params: Params; paramsByLang?: Record<string, { params: Params }> } | null;
const cellText = (c: Cell) =>
  c && Object.entries({ ...c.params, ...c.paramsByLang?.[lang]?.params }).reduce((txt, [k, v]) => txt.replace(`{${k}}`, () => String(v)), i.comparison.cells[c.key]);
const checked = new Intl.DateTimeFormat(lang, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(competitors.checked));
---
<section class="k-wrap k-sec" id="comparison" data-reveal>
  <div class="k-fig"><b>{i.home.compare.figNo}</b> — {i.home.compare.fig}</div>
  <h2 class="k-h2">{c.title} {c.titleHighlight}</h2>
  <p class="k-sub">{c.subtitle}</p>
  <div class="k-tablewrap k-rise" style="--d:0.1s">
    <table class="k-table">
      <thead>
        <tr>
          {c.headers.map((h, idx) => <th class={idx === 1 ? 'k-us' : idx === 0 ? 'k-feat' : ''}>{h}</th>)}
          {competitors.vendors.map((v) => <th>{v.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {c.rows.map((row) => (
          <tr>
            <th class="k-feat" scope="row">{row.feature}</th>
            <td class="k-us">{fillPrices(row.values[0])}</td>
            {competitors.vendors.map((v) => {
              const txt = cellText(v.cells[row.id as keyof typeof v.cells] as Cell);
              return <td>{txt ? txt : <span class="k-unknown" title={c.unknown} aria-label={c.unknown}>—</span>}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="k-caption">{c.caption.replace('{date}', checked)}</p>
</section>

<style>
  .k-tablewrap { overflow-x: auto; border: 1.5px solid var(--ink); background: rgba(242, 239, 231, 0.92); }
  .k-table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 14.5px; }
  .k-table th,
  .k-table td { padding: 14px 16px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
  .k-table thead th { border-bottom: 1.5px solid var(--ink); font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .k-table tbody tr:last-child > * { border-bottom: 0; }
  .k-table td { color: var(--muted); }
  .k-feat { position: sticky; left: 0; min-width: 140px; background: var(--paper); font-weight: 600; color: var(--ink); }
  .k-table thead .k-us { background: var(--ink); color: var(--paper); }
  .k-table tbody .k-us { background: rgba(27, 34, 48, 0.05); font-weight: 600; color: var(--ink); }
  .k-unknown { color: var(--muted); }
  .k-caption { margin: 12px 0 0; max-width: none; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }

  @media (max-width: 720px) {
    .k-table { min-width: 640px; font-size: 13px; }
    .k-table th,
    .k-table td { padding: 10px 12px; }
    .k-feat { min-width: 110px; }
  }
</style>
