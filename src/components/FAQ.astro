---
/**
 * Câu hỏi thường gặp (spec trang chủ §4 dòng 9): 9 câu như website cũ, dạng <details>.
 * JSON-LD FAQPage nằm ở đây, đọc cùng faq.items với phần hiện ra: trang nào không hiện FAQ thì không khai
 * FAQPage (VEIL-1031; trước đó Layout.astro khai nó trên mọi trang).
 */
import type { Lang } from '../i18n/utils';
import { t, defaultLang, getLocalizedPath, docsUrl } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang || defaultLang;
const i = t(lang);
const q = i.faq;
// Link đọc thêm theo thứ tự 9 câu trong faq.items (VEIL-1333): đặt ngoài <p> trả lời để acceptedAnswer.text không đổi.
const MORE = [
  docsUrl('profiles/fingerprinting', lang),
  getLocalizedPath('/pricing', lang),
  docsUrl('reference/plans-and-license', lang),
  getLocalizedPath('/download', lang),
  docsUrl('sync/overview', lang),
  docsUrl('profiles/proxy', lang),
  getLocalizedPath('/features/mcp', lang),
  docsUrl('automation/overview', lang),
  getLocalizedPath('/refund', lang),
];
if (MORE.length !== q.items.length) throw new Error(`FAQ: ${MORE.length} link cho ${q.items.length} câu`);
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: q.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section class="k-wrap k-sec" id="faq" data-reveal>
  <div class="k-fig">{i.home.faq.fig}</div>
  <h2 class="k-h2">{q.title} {q.titleHighlight}</h2>
  <p class="k-sub">{q.subtitle}</p>
  <div class="k-faq k-rise" style="--d:0.1s">
    {q.items.map((item, n) => (
      <details open={n < 2}>
        <summary class="faq-question">
          <em>{String(n + 1).padStart(2, '0')}</em><span>{item.q}</span><span class="ms" data-icon="add" aria-hidden="true"></span>
        </summary>
        <p>{item.a}</p>
        <p class="k-faq-more"><a href={MORE[n]}>{i.home.more.faq}</a></p>
      </details>
    ))}
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

<style>
  .k-faq { border-top: 1.5px solid var(--ink); }
  .k-faq details { border-bottom: 1px solid var(--rule); background: rgba(242, 239, 231, 0.92); }
  .k-faq summary { display: grid; grid-template-columns: 52px minmax(0, 1fr) 28px; align-items: center; gap: 8px; padding: 18px 12px; list-style: none; cursor: pointer; font-size: 16.5px; font-weight: 600; }
  .k-faq summary::-webkit-details-marker { display: none; }
  .k-faq summary em { font-style: normal; font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--acc); }
  /* Hộp vuông 1em trước khi xoay: glyph "add" rộng hơn line-height (28px so với 22px), xoay 45°
     trên hộp không vuông đẩy bounding box qua ngưỡng brokenIcons của shot-home.cjs (đo 2026-09-29). */
  .k-faq summary .ms { display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; transition: transform 0.2s ease; }
  .k-faq details[open] summary .ms { transform: rotate(45deg); }
  .k-faq p { max-width: 54em; margin: 0; padding: 0 48px 20px 72px; font-size: 15px; line-height: 1.65; color: var(--muted); }
  .k-faq .k-faq-more { margin-top: -10px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; }
  .k-faq .k-faq-more a { color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 720px) {
    .k-faq summary { grid-template-columns: 36px minmax(0, 1fr) 24px; padding: 16px 8px; font-size: 15.5px; }
    .k-faq p { padding: 0 16px 18px 52px; }
    .k-faq .k-faq-more { margin-top: -8px; }
  }
</style>
