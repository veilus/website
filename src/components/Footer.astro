---
/**
 * Chân trang dùng chung mọi trang: cột liên kết và "ô tên bản vẽ" (spec trang chủ §3) chứa liên kết
 * pháp lý, số bản vẽ, bản quyền.
 */
import type { Lang } from '../i18n/utils';
import LogoMark from './LogoMark.astro';
import { t, defaultLang, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang || defaultLang;
const i = t(lang);
const f = i.footer;
const home = getLocalizedPath('/', lang);

const COLUMNS = [
  {
    title: f.product,
    links: [
      [f.productLinks[0], `${home}#features`],
      [f.productLinks[1], getLocalizedPath('/pricing', lang)],
      [f.productLinks[2], getLocalizedPath('/changelog', lang)],
      [i.nav.download, getLocalizedPath('/download', lang), 'footer_download'],
    ],
  },
  {
    title: f.resources,
    links: [
      [f.resourceLinks[0], 'https://docs.veilus.io'],
      [f.resourceLinks[1], 'https://blog.veilus.io'],
      [f.resourceLinks[2], getLocalizedPath('/about', lang)],
      [f.resourceLinks[3], getLocalizedPath('/contact', lang)],
    ],
  },
  {
    title: f.community,
    links: [
      ['Telegram', 'https://t.me/veilusbrowser'],
      ['Twitter/X', 'https://x.com/veilusbrowser'],
      ['GitHub', 'https://github.com/veilus'],
    ],
  },
];
const LEGAL = [
  [f.legal[0], getLocalizedPath('/terms', lang)],
  [f.legal[1], getLocalizedPath('/privacy', lang)],
  [f.legal[2], getLocalizedPath('/refund', lang)],
  [f.legal[3], getLocalizedPath('/cookies', lang)],
  [f.legal[4], getLocalizedPath('/acceptable-use', lang)],
];
const external = (href: string) =>
  href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<footer class="k-wrap">
  <div class="k-fgrid">
    <div class="k-fbrand">
      <a class="k-mark" href={home}><LogoMark />VEILUS</a>
      <p>{f.tagline}</p>
    </div>
    {COLUMNS.map((col) => (
      <div class="k-fcol">
        <p class="k-ftitle">{col.title}</p>
        <ul>
          {col.links.map(([name, href, cta]) => (
            <li><a href={href} data-cta={cta} {...external(href)}>{name}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="k-foot">
    <div class="k-legal">{LEGAL.map(([name, href]) => <a href={href}>{name}</a>)}</div>
    <div>{f.copyright}</div>
  </div>
</footer>

<style>
  .k-fgrid { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr)); gap: 32px; padding: 32px 0; border-top: 1.5px solid var(--ink); }
  .k-fbrand p { margin-top: 8px; font-size: 14px; color: var(--muted); }
  .k-ftitle { margin-bottom: 12px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .k-fcol ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .k-fcol a { font-size: 14.5px; color: var(--ink); }
  .k-fcol a:hover { color: var(--acc); }
  .k-foot { display: grid; grid-template-columns: minmax(0, 1fr) auto; margin-bottom: 40px; border: 1.5px solid var(--ink); background: var(--paper); font-family: var(--font-mono); font-size: 11.5px; }
  .k-foot > div { padding: 12px 16px; border-left: 1px solid var(--rule); }
  .k-foot > div:first-child { border-left: 0; }
  .k-legal { display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .k-legal a { color: var(--ink); }

  @media (max-width: 1080px) {
    .k-fgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .k-fbrand { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .k-fgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .k-foot { grid-template-columns: 1fr; }
    .k-foot > div { border-left: 0; border-top: 1px solid var(--rule); }
    .k-foot > div:first-child { border-top: 0; }
  }
</style>
