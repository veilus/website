---
import type { Lang } from '../i18n/utils';
import { t, defaultLang } from '../i18n/utils';
interface Props { lang?: Lang; }
const lang = Astro.props.lang || defaultLang;
const i = t(lang);
const icons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>`,
];
---
<section class="section pain" id="problem" data-animate>
  <div class="container">
    <div class="section-header">
      <span class="badge">{i.pain.badge}</span>
      <h2 class="mt-md">{i.pain.title} <span class="text-gradient">{i.pain.titleHighlight}</span></h2>
    </div>
    <div class="pain-grid">
      {i.pain.items.map((item, idx) => (
        <div class="pain-card card">
          <div class="pain-icon" set:html={icons[idx]} />
          <h3 class="pain-title">{item.title}</h3>
          <p class="pain-desc">{item.desc}</p>
        </div>
      ))}
    </div>
    <p class="pain-bridge">{i.pain.bridge}</p>
  </div>
</section>
<style>
  .pain-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
  .pain-card { display: flex; flex-direction: column; gap: var(--space-md); cursor: default; }
  .pain-icon { width: 40px; height: 40px; padding: 8px; border-radius: var(--radius-md); background: color-mix(in srgb, var(--color-gold-light) 10%, transparent); color: var(--color-gold-light); display: flex; align-items: center; justify-content: center; }
  .pain-icon :global(svg) { width: 24px; height: 24px; }
  .pain-title { font-size: 1.125rem; font-weight: 700; }
  .pain-desc { font-size: 0.9375rem; line-height: 1.6; }
  .pain-bridge { margin: var(--space-2xl) auto 0; max-width: 56ch; text-align: center; font-size: 1.125rem; font-weight: 600; color: var(--color-text); }
  @media (max-width: 1024px) { .pain-grid { grid-template-columns: 1fr; max-width: 560px; margin: 0 auto; } }
</style>
