---
import Layout from "../../../layouts/Layout.astro";
import McpPage from "../../../components/McpPage.astro";
import { t, supportedLangs, defaultLang, type Lang } from "../../../i18n/utils";

export function getStaticPaths() {
  // Ngôn ngữ mặc định (en) do /features/mcp.astro dựng; /en/* chuyển hướng 301 về gốc (public/_redirects)
  return supportedLangs.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const i = t(lang);
---

<Layout lang={lang} title={i.mcpPage.metaTitle} description={i.mcpPage.metaDescription}>
  <McpPage lang={lang} />
</Layout>
