---
import Layout from "../../../layouts/Layout.astro";
import SolutionPage from "../../../components/SolutionPage.astro";
import { defaultLang, type Lang } from "../../../i18n/utils";
import { entry, ALL_SLUGS, SOLUTION_LANGS } from "../../../i18n/solutions";

export function getStaticPaths() {
  // en is built by /solutions/[slug].astro
  return SOLUTION_LANGS.filter((l) => l !== defaultLang).flatMap((lang) =>
    ALL_SLUGS.map((slug) => ({ params: { lang, slug } })),
  );
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const p = entry(lang, slug);
---

<Layout lang={lang} title={p.metaTitle} description={p.metaDescription} langs={SOLUTION_LANGS}>
  <SolutionPage lang={lang} slug={slug} />
</Layout>
