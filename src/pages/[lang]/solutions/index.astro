---
import Layout from "../../../layouts/Layout.astro";
import SolutionsIndex from "../../../components/SolutionsIndex.astro";
import { defaultLang, type Lang } from "../../../i18n/utils";
import { solutions, SOLUTION_LANGS } from "../../../i18n/solutions";

export function getStaticPaths() {
  // Solutions copy exists in en and vi only (VEIL-1448); en is built by /solutions/index.astro
  return SOLUTION_LANGS.filter((l) => l !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = solutions(lang).index;
---

<Layout lang={lang} title={s.metaTitle} description={s.metaDescription} langs={SOLUTION_LANGS}>
  <SolutionsIndex lang={lang} />
</Layout>
