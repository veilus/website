---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Purchase from "../components/Purchase.astro";
import { t, defaultLang } from "../i18n/utils";
import { currencyForLang } from "../scripts/purchase-core.js";

const i = t(defaultLang);
// Mô tả riêng thay cho mô tả trang chủ: câu phụ đề trang đang hiện, chọn theo loại tiền như Purchase.astro.
const description = currencyForLang(defaultLang) === "VND" ? i.buy.subtitleVnd : i.buy.subtitleUsd;
---

<Layout lang={defaultLang} title={`${i.buy.title} — Veilus`} description={description} privateUrl>
  <Navbar lang={defaultLang} />
  <main>
    <Purchase lang={defaultLang} />
  </main>
  <Footer lang={defaultLang} />
</Layout>
