---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { langRedirectTarget, runLangRedirect } from '../scripts/lang-redirect.js';

const lang = 'en';
// Tự chuyển ngôn ngữ ở lần vào đầu (src/scripts/lang-redirect.js), nhúng nguyên hai hàm vào <head> trước GA.
// window.veilusLangTo khác null nghĩa là trang đang chuyển đi: Layout không nạp GA, page_view chỉ bắn ở trang đích.
const langRedirect = `window.veilusLangTo=(${runLangRedirect})(window,${langRedirectTarget});`;
---

<Layout lang={lang}>
  <script is:inline slot="head" set:html={langRedirect} />
  <HomePage lang={lang} />
</Layout>
