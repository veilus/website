---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';

const lang = 'en';
---

<Layout lang={lang}>
  <HomePage lang={lang} />
</Layout>

<script>
  // Auto-detect browser language and redirect on first visit
  (function() {
    const STORAGE_KEY = 'veilus_lang_detected';
    const SUPPORTED = ['vi', 'zh', 'ru', 'es', 'pt', 'tr', 'id'];

    // Skip if already detected or user manually navigated here
    if (localStorage.getItem(STORAGE_KEY)) return;

    // Get browser language (e.g., 'vi', 'zh-CN', 'pt-BR')
    const browserLang = navigator.language || (navigator as any).userLanguage || '';
    const primary = browserLang.split('-')[0].toLowerCase();

    // Mark as detected so we don't redirect again
    localStorage.setItem(STORAGE_KEY, primary);

    // Redirect if matches a supported non-English language
    if (SUPPORTED.includes(primary)) {
      window.location.replace('/' + primary + '/');
    }
  })();
</script>
