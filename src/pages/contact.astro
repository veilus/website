---
import Layout from "../layouts/Layout.astro";
import ContactPage from "../components/ContactPage.astro";
import { t, defaultLang } from "../i18n/utils";

const i = t(defaultLang);
---

<Layout lang={defaultLang} title={i.contact.metaTitle} description={i.contact.metaDescription}>
  <ContactPage lang={defaultLang} />
</Layout>
