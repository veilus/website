import ChangelogPage from "../components/ChangelogPage.astro";
import { t, defaultLang } from "../i18n/utils";

const i = t(defaultLang);
---

<Layout lang={defaultLang} title={i.changelog.metaTitle} description={i.changelog.metaDescription}>
  <ChangelogPage lang={defaultLang} />
</Layout>
